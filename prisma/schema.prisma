// Prisma schema for MLS Employee Portal.
// Standard Auth.js tables (User, Account, Session, VerificationToken)
// plus a Role enum for RBAC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // privilege roles (controls what they can DO in the portal).
  //   SUPER:     full access to everything. hidden role - only IT can
  //              see/assign it. red badge. used for top-level superusers.
  //   ELEVATED:  IT_ADMIN, ADMIN, MANAGER  (can manage users + content)
  //   STANDARD:  HR, SUPERVISOR, STAFF      (read-only access)
  // see src/lib/roles.js for the permission helpers.
  SUPER
  IT_ADMIN
  ADMIN
  MANAGER
  HR
  SUPERVISOR
  STAFF
}

model User {
  id            String    @id @default(cuid())
  // full / legal name (records). managed by admin/HR. shown only on the contact
  // detail card + admin panel (gated to admin/management when hideLegalName).
  name          String?
  // optional preferred first / last name. self-editable in settings. the name
  // shown everywhere = (preferredFirstName or legal first) + (preferredLastName
  // or legal last), e.g. "Manu" + legal last "Uribe" -> "Manu Uribe".
  preferredFirstName String?
  preferredLastName  String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STAFF)
  // job title separate from privilege role. free-form string so we can
  // add new ones without a schema migration. examples: "Owner/Director",
  // "Program Manager", "Field Supervisor", "HR Administrator", "ILS",
  // "Day Program", "Supported Living", etc.
  title         String?
  // which office(s) they work out of, from HR's roster. "ILS" (My Life Services)
  // and/or "DP" (Day Program) - a list so someone who splits both keeps one row.
  offices       String[]  @default([])
  // soft delete - when set, this user cant sign in anymore. preserves
  // history (audit trails, role at time of action, etc.) rather than
  // hard deleting the row. set back to null to reactivate.
  deactivatedAt DateTime?
  // their actual employment start date with MLS (per HR records).
  // separate from createdAt which is just when their row was added to
  // our portal db. used for tenure displays + sorting in the admin list.
  hireDate      DateTime?
  // contact phone for the team directory. self-editable in Settings,
  // admins can also set it. stored as the raw string the user typed.
  phone         String?
  // free-text working hours shown on their contact detail page, e.g.
  // "Mon-Fri 9am-5pm". self-editable in Settings, admins too.
  workingHours  String?
  // when false, the phone is hidden on the PUBLIC shared contact link
  // (/c/[id]). still shown to signed-in staff in the portal. opt-out in
  // Settings; defaults to sharing.
  sharePhonePublicly Boolean @default(true)
  // when true, the full/legal name is hidden from coworkers + the public link -
  // only the oversight tier (HR/management) + the person themselves see it.
  // self-set in settings. they should have a display name set so something
  // still shows.
  hideLegalName Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  posts         Post[]     @relation("PostAuthor")
  postedPosts   Post[]     @relation("PostPostedBy")
  comments      Comment[]
  likes         PostLike[]
  announcements        Announcement[]        @relation("AnnouncementAuthor")
  announcementsPosted  Announcement[]        @relation("AnnouncementPostedBy")
  announcementComments AnnouncementComment[]
  announcementLikes    AnnouncementLike[]
  announcementAcks     AnnouncementAck[]
  formSubmissions      FormSubmission[]
  announcementMeetingChoices AnnouncementMeetingChoice[]
  announcementMeetingResponses AnnouncementMeetingResponse[]
  announcementEventRsvps AnnouncementEventRsvp[]
  nlSubmitted   NewsletterItem[] @relation("NLSubmittedBy")
  nlApproved    NewsletterItem[] @relation("NLApprovedBy")
  nlPublished   NewsletterItem[] @relation("NLPublishedBy")
  feedbackAuthored FeedbackItem[] @relation("FeedbackAuthor")
  feedbackResolved FeedbackItem[] @relation("FeedbackResolvedBy")
  resourcesSubmitted Resource[]   @relation("ResourceSubmittedBy")
  resourcesApproved  Resource[]   @relation("ResourceApprovedBy")
  resourcesVerified  Resource[]   @relation("ResourceVerifiedBy")
  sitePhotos    SitePhoto[]   @relation("SitePhotoUploadedBy")
  notifications Notification[]
  timesheetBatches TimesheetBatch[] @relation("TimesheetBatchUploadedBy")
  timesheets       Timesheet[]      @relation("TimesheetEmployee")
  timesheetsApproved Timesheet[]    @relation("TimesheetApprovedBy")
  timesheetCorrectionsResolved TimesheetCorrection[] @relation("TimesheetCorrectionResolvedBy")
}

// company device / asset log. viewable by the oversight tier; editing is
// Admin and up (role-based, see src/lib/roles.js). tracks Apple + other
// hardware David purchases.
enum DeviceType {
  LAPTOP
  DESKTOP
  TABLET
  PHONE
  OTHER
}

enum DeviceStatus {
  IN_USE
  STORAGE
  REPAIR
  RETIRED
}

model Device {
  id           String       @id @default(cuid())
  name         String       // e.g. "David's MacBook Pro 16"
  type         DeviceType   @default(LAPTOP)
  serialNumber String?
  // purchase price stored in whole cents to avoid float rounding.
  priceCents   Int?
  purchaseDate DateTime?
  // free text: who has it / where it lives, e.g. "David - home office".
  assignedTo   String?
  status       DeviceStatus @default(IN_USE)
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

// external partners / community resources for the team contacts page
// (e.g. Integrity Cottages, food banks, clinics). staff submit, IT or
// management approve before they show on the directory.
enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

// operational state - is the place actually running. distinct from the
// ResourceStatus above, which is the moderation/approval workflow.
enum ResourceOpStatus {
  ACTIVE
  TEMPORARILY_UNAVAILABLE
  NEEDS_VERIFICATION
  CLOSED
}

model Resource {
  id          String         @id @default(cuid())
  name        String
  // top-level bucket shown as a chip, e.g. "Housing", "Food banks".
  category    String?
  // finer type within the category, e.g. "Food pantry", "Mobile food
  // distribution". options are per-category (see src/lib/contacts.js).
  subtype     String?
  // organization behind the location, if different from the resource name.
  orgName     String?
  phone       String?
  email       String?
  website     String?
  // direct link to book/schedule, if they take appointments online.
  appointmentLink String?
  // free text, e.g. "Call before visiting" or "Text to schedule".
  contactInstructions String?
  address     String?
  city        String?
  state       String?
  zip         String?
  // who the service covers, e.g. "Anaheim residents only". free text.
  serviceArea String?
  lat         Float?
  lng         Float?
  // legacy free-text hours. superseded by `schedule` for new entries but
  // kept so the imported food-bank hours still show.
  hours       String?
  // structured recurring schedule rows: [{ day, frequency, start, end }]
  schedule    Json?
  // populations served (multi). filterable. see WHO_IT_SERVES_OPTIONS.
  whoItServes String[]       @default([])
  appointmentRequired Boolean @default(false)
  // category-specific answers (eligibility + food details). see
  // buildDetails in src/lib/contacts.js for the shape.
  details     Json?
  // short public-facing description / what they do.
  notes       String?
  // staff-only notes, never shown to clients.
  internalNotes String?
  // where this info came from (url, person, flyer).
  source      String?
  operationalStatus ResourceOpStatus @default(ACTIVE)
  // featured by management - surfaces in a "Staff picks" row up top.
  staffPick   Boolean        @default(false)
  // verification trail so the directory doesn't go stale.
  lastVerifiedAt DateTime?
  verifiedById   String?
  verifiedBy     User?        @relation("ResourceVerifiedBy", fields: [verifiedById], references: [id])
  status      ResourceStatus @default(PENDING)
  submittedById String
  submittedBy   User         @relation("ResourceSubmittedBy", fields: [submittedById], references: [id])
  approvedById  String?
  approvedBy    User?        @relation("ResourceApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  reviewNote    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

// photos shown on the public About page, managed from the portal by
// admin/IT so they can swap site imagery without a code change. uploaded
// to vercel blob; we only keep the url + a bit of metadata here.
model SitePhoto {
  id               String   @id @default(cuid())
  url              String
  // which spot on the public page: "about-hero" | "agency-overview" |
  // "partnership". validated against src/lib/site-photos.js.
  section          String
  caption          String?
  // alt text for screen readers / when the image cant load.
  alt              String?
  // order within a section (low = first). drives the slideshow order.
  sortOrder        Int      @default(0)
  // turned off to hide from the site without deleting the upload.
  active           Boolean  @default(true)
  // uploader attests a signed photo release is on file for anyone pictured.
  consentConfirmed Boolean  @default(false)
  uploadedById     String?
  uploadedBy       User?    @relation("SitePhotoUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([section, sortOrder])
}

// MLS Hub - internal feed for posts (flyers, helpful info) + comments.
// soft-deleted via deletedAt so threads dont collapse if an author leaves.
model Post {
  id         String     @id @default(cuid())
  authorId   String
  author     User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  imageUrl   String?
  // when an IT/admin posts on behalf of someone else, authorId is the
  // person being credited and postedById is who actually hit submit.
  // null when the author posted it themselves. kept for the audit trail.
  postedById String?
  postedBy   User?      @relation("PostPostedBy", fields: [postedById], references: [id])
  // tag string is validated against the list in src/lib/hub.js. kept as
  // free string so we can add new tags without a migration.
  tag        String
  // optional expiration. once past, the post shows an "Expired" badge
  // and drops below active posts in the feed.
  expiresAt  DateTime?
  // pinning is admin-only. null = not pinned. when set, post floats to
  // top of the feed.
  pinnedAt   DateTime?
  pinnedById String?
  // edit tracking. null = never edited. set explicitly by edit action.
  editedAt   DateTime?
  // soft delete. set to a timestamp by the delete action.
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  comments   Comment[]
  likes      PostLike[]

  @@index([createdAt])
  @@index([pinnedAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
}

// PostLike is the join table for the heart/like reaction. composite PK
// so each user can only like a post once. removing the row = unlike.
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// Announcements - a second internal feed, identical in shape to the Hub
// (Post/Comment/PostLike) but separate so it stays a clean broadcast board.
// only Supervisor+ can create announcements (see src/lib/roles.js
// isSupervisorUp); everyone reads, comments, and reacts.
model Announcement {
  id         String     @id @default(cuid())
  authorId   String
  author     User       @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // optional title - used by the Changelog type (Discord-style heading). plain
  // announcements leave it null and just use content.
  title      String?
  content    String
  imageUrl   String?
  // proxy posting: authorId is the credited person, postedById is who hit
  // submit (null when posted by themselves). kept for the audit trail.
  postedById String?
  postedBy   User?      @relation("AnnouncementPostedBy", fields: [postedById], references: [id])
  tag        String
  expiresAt  DateTime?
  pinnedAt   DateTime?
  pinnedById String?
  editedAt   DateTime?
  deletedAt  DateTime?
  // null = draft: created via "Preview", not shown in the feed, no emails sent.
  // set to now() on Publish. existing rows are backfilled to createdAt so nothing
  // already posted disappears.
  publishedAt DateTime?
  // when true, staff get an "I read this" box and management gets a
  // who-has/who-hasnt roster. opt-in per announcement (see requireAck box
  // on the form). plain posts leave it false.
  requireAck Boolean    @default(false)
  // the acknowledgment audience - who is expected to acknowledge (drives the
  // roster denominator + the email send default). ackEveryone = the whole
  // expected-ack staff set; otherwise ackTitles lists the job titles targeted.
  ackEveryone Boolean   @default(true)
  ackTitles   String[]  @default([])
  // specific individuals to target (in addition to ackTitles), used when the
  // poster narrows a title role to certain people. unioned with ackTitles.
  ackUserIds  String[]  @default([])
  // an optional fillable form attached to this announcement: acknowledging it
  // means filling + submitting the form, which writes the ack (see FormSubmission).
  formId      String?
  form        Form?     @relation(fields: [formId], references: [id])
  // DOCUMENTS THAT RIDE ALONG WITH THE POST. [{ name, url, formId?, bytes? }]
  //
  // Two sources on purpose. A `formId` entry points at something already in the
  // forms library, so the file is stored once and stays browsable at
  // /portal/forms afterwards. An entry without one was uploaded straight onto
  // the post and lives only here - which is the case that lets HR attach
  // something without waiting on a deploy, the gap that stopped Britny getting
  // the workers' comp training out on 2026-08-10.
  //
  // Json rather than a table because it is a short ordered list read only with
  // its parent, and nothing ever queries across posts by attachment.
  attachments Json?
  // Company Meeting fields (used when tag = "Company Meeting").
  meetingKind      String?  // Training | Team meeting | All-hands | Orientation | Other
  meetingFormat    String?  // zoom | in_person | hybrid
  meetingMandatory Boolean  @default(false)
  zoomLink         String?
  zoomCode         String?
  meetingAddress   String?
  // optional sessions to pick from: [{ id, label }]. empty = single meeting.
  meetingOptions   Json?
  // when true, attendees may pick more than one session.
  meetingMultiPick Boolean  @default(false)
  // the meeting's start as an absolute instant (UTC). each viewer sees it in
  // their own device timezone. meetingTimezone is the zone the author set it in
  // (IANA, e.g. America/New_York) - kept for editing + a "set in" label.
  meetingAt        DateTime?
  meetingTimezone  String?
  // duration estimate in minutes (from -> optional to for a range).
  meetingDurationFromMin Int?
  meetingDurationToMin   Int?
  // optional "response needed by" deadline for a meeting RSVP. the auto second-
  // notice email (Phase C) fires at this instant; tz kept for the editor label.
  meetingResponseDueAt   DateTime?
  meetingResponseDueTz   String?
  // Phase C (auto-reminders): settable lead time for the "starting soon" email;
  // zoomLinkTbd = "link provided closer to the date" (attendees see a note, the
  // author gets a nudge). the *SentAt stamps keep the cron from double-firing.
  meetingReminderLeadMin      Int       @default(10)
  zoomLinkTbd                 Boolean   @default(false)
  // also send a "meeting tomorrow" reminder at 8pm the day before each session.
  meetingNightBefore          Boolean   @default(true)
  meetingAuthorNudgeSentAt    DateTime?
  meetingResponseNoticeSentAt DateTime?
  meetingChoices   AnnouncementMeetingChoice[]
  meetingResponses AnnouncementMeetingResponse[]
  meetingReminders AnnouncementMeetingReminder[]
  // last time the "Send to staff by email" blast went out, so the roster
  // can show "last emailed ..." and re-sends only hit the un-acked.
  ackEmailSentAt DateTime?
  // Event fields (used when tag = "Event"). audience = "employee" (staff
  // get-together) or "client" (staff + clients, e.g. a BBQ). one date + optional
  // end, a venue name + address for the map embed. staff RSVP for a headcount;
  // on client events they also say how many clients they're bringing.
  eventAudience     String?
  eventAt           DateTime?
  eventTimezone     String?
  eventEndAt        DateTime?
  eventLocationName String?
  eventAddress      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  comments   AnnouncementComment[]
  likes      AnnouncementLike[]
  acks       AnnouncementAck[]
  eventRsvps AnnouncementEventRsvp[]

  @@index([createdAt])
  @@index([pinnedAt])
}

// one person's RSVP to an Event, for a headcount. going = they're coming;
// clientCount = how many clients they're bringing (client events only). one row
// per person (composite PK).
model AnnouncementEventRsvp {
  announcementId String
  userId         String
  going          Boolean      @default(true)
  clientCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// read-receipt for an ack-required announcement. one row per person who
// acknowledged, composite PK so each person acks once. mirrors
// AnnouncementLike. viaEmail records whether they clicked the one-click
// email link or checked the box in the portal.
model AnnouncementAck {
  announcementId String
  userId         String
  viaEmail       Boolean      @default(false)
  // set when an admin logged the acknowledgment on someone's behalf (out sick,
  // tech trouble, etc). null = the person acknowledged it themselves. plain id,
  // resolved to a name at render time so we can show "recorded by X".
  recordedById   String?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([announcementId, createdAt])
}

model AnnouncementLike {
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// a person's pick(s) for a Company Meeting's session options. one row per
// chosen option, so a user can pick several when meetingMultiPick is on; the
// composite PK keeps each (user, option) unique. drives the who-picked-what
// roster.
model AnnouncementMeetingChoice {
  announcementId String
  userId         String
  optionId       String
  // per-session roll-call: "present" / "absent" / null (not marked). used for
  // multi-session + series meetings so each session tracks its own attendance;
  // single-session meetings keep using AnnouncementMeetingResponse.attended.
  attended       String?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId, optionId])
}

// a person's overall response to a Company Meeting: going, or cant make it (with
// an optional reason). one row per (announcement, user) - the row existing means
// they responded, which also counts as their acknowledgment. which session(s)
// theyre going to lives in AnnouncementMeetingChoice. drives the Going / Cant
// make it / No response roster.
model AnnouncementMeetingResponse {
  announcementId String
  userId         String
  cantMakeIt     Boolean      @default(false)
  reason         String?
  // roll-call (Phase B): admin marks "present" / "absent" on the day. null =
  // not yet marked. attendance is meeting-level (the session they picked).
  attended       String?
  // true when the response was last recorded through a one-click email link
  // (no login), so the attendance report can show how it came in.
  viaEmail       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// idempotency for the Phase C "starting soon" reminder: one row per session that
// has been reminded (optionId = "" for a single-session meeting). the cron
// checks this before sending so a 5-min poll never double-fires. survives edits.
model AnnouncementMeetingReminder {
  announcementId String
  optionId       String       @default("")
  // which reminder: "soon" (lead-min before) or "night" (8pm the day before).
  kind           String       @default("soon")
  sentAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, optionId, kind])
}

// the Forms library - a managed list of blank form templates (PDFs). staff
// browse + download; fillable PDFs (AcroForm) can be filled in the browser and
// downloaded/sent. NO filled-in copies are ever stored here - only the blank
// templates. fileUrl points at a public /forms/* path or a Vercel Blob URL.
model Form {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String?
  fileUrl     String
  // true when the PDF has AcroForm fields, so it can be filled in-app.
  fillable    Boolean  @default(false)
  // random, unguessable id for the public /f/<slug> share link (so the link is
  // only reachable if it's shared, not by guessing the readable form id).
  shareSlug   String?  @unique
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions   FormSubmission[]
  announcements Announcement[]

  @@index([category])
}

// a stored, signed form submission - the durable record behind the forms admin
// panel + retention, and (when tied to an announcement) the proof that completes
// an acknowledgment. the signed PDF lives in Blob under an unguessable key and is
// streamed back through a gated route, never linked to the browser.
model FormSubmission {
  id             String   @id @default(cuid())
  formId         String
  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  // set when this submission fulfills an announcement's required acknowledgment
  announcementId String?
  // who it's attributed to: set immediately for signed-in submits; set later for
  // no-login submits (email-match or a manual assign in the admin panel).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // how it got attributed: signed-in | email-match | assigned | unassigned
  attribution    String   @default("unassigned")
  // what the submitter typed - drives reconciliation for no-login submits
  submitterName  String
  submitterEmail String
  pdfUrl         String
  pdfName        String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([formId, createdAt])
  @@index([announcementId])
  @@index([userId])
}

// one upload of the QSP "Simple Timesheet" export - a single PDF holding every
// employee for a pay period. parsing it produces one Timesheet row per person.
model TimesheetBatch {
  id           String   @id @default(cuid())
  // the pay period exactly as QSP printed it, e.g. "07/16/26" / "07/31/26".
  periodFrom   String
  periodTo     String
  // the uploaded source PDF, kept for audit (Blob, streamed back through a
  // gated route like every other stored document here).
  sourceUrl    String?
  sourceName   String?
  // the Employee Schedules calendar PDF, when one was uploaded alongside. it's
  // the second opinion the checks screen leans on, and until now it was parsed
  // in memory and thrown away - so the screen could say "schedule has 74.30"
  // with no way for anyone to check that reading against the document.
  scheduleUrl  String?
  scheduleName String?
  // the QSClock Time and Attendance export. the only source that separates a
  // punch someone clocked from one typed in afterwards, which is what decides
  // whether a premium can be signed off or needs a person to look at it.
  clockUrl     String?
  clockName    String?
  // the Rest Periods Report. decides whether a rest break was actually taken,
  // which is what the bigger half of the premium total turns on.
  //
  // NOT COLLECTED SINCE 2026-08-06, when the export set was cut to three
  // reports. Kept, along with the clock columns above, because the decision was
  // "hold for now, we may add it back" - and dropping the columns would mean a
  // second migration to undo. Existing batches still hold theirs.
  restsUrl     String?
  restsName    String?
  // SUPERSEDED by restsByDate, which holds these rows and every other one.
  // Left in place rather than dropped in a second migration; nothing writes it
  // any more and it can go whenever the schema is next touched.
  restsAttention Json?
  // EVERY row of that report, from `rests.allRestRows()`: the recorded out and
  // in times, the length, whether it counted, and why if not.
  //
  // The times are the point. The signed sheet colours only what the two reports
  // actually recorded - a punch gap is not evidence of a break - and a properly
  // taken rest is PAID and stays ON the clock, so it leaves no gap to colour.
  // 204 of the 226 days carrying a rest have no punch gap at all, which is why
  // a count was never going to be enough.
  //
  // Stored on the BATCH because the report is one document covering everyone.
  // Nullable: batches uploaded before this column exists have nothing here.
  restsByDate    Json?
  // the Simple Payroll Processing Report (.xls). one row per employee carrying
  // QSP's OWN regular, overtime and double-time figures - the numbers payroll
  // actually runs on. This is what settles an overtime disagreement without
  // anybody re-reading a PDF, and it reconciles with the timesheet exactly.
  payrollUrl   String?
  payrollName  String?
  // whether sends from this batch were redirected to the test inbox. recorded
  // per batch so a test run can never be mistaken for a real one later.
  testMode     Boolean  @default(true)
  // uploaded before the pay period ended, with the days that had not happened
  // yet dropped. Recorded for the same reason testMode is: this batch's hours
  // are a partial record, its last workweek is cut off mid-week, and nothing
  // else on the batch would say so afterwards.
  partialPeriod Boolean @default(false)
  // the first and last day that actually survived the trim, e.g. "08/01/26" and
  // "08/09/26". periodFrom/periodTo still say what QSP printed on the export,
  // because that is what the document says - and on a partial upload the two
  // disagree on purpose, since QSP returns the whole period whatever range it
  // was asked for.
  partialFrom    String?
  partialThrough String?
  uploadedById String
  uploadedBy   User     @relation("TimesheetBatchUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  timesheets   Timesheet[]

  @@index([createdAt])
}

// one employee's corrected timesheet for a pay period: the computed figures, the
// generated PDF, who it went to, and the signed copy that comes back.
model Timesheet {
  id          String         @id @default(cuid())
  batchId     String
  batch       TimesheetBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // the name exactly as QSP printed it, e.g. "Miranda, Gabriel". kept even after
  // matching so the operator can always see what the source said.
  sourceName  String
  // the matched portal account. null until someone is picked - nothing sends
  // without it.
  userId      String?
  user        User?          @relation("TimesheetEmployee", fields: [userId], references: [id], onDelete: SetNull)
  // how the match happened: exact | fuzzy | manual | unmatched
  matchMethod String         @default("unmatched")

  // computed figures (also in `data`, duplicated here for lists + sorting)
  rawHours     Float @default(0)  // as exported by QSP
  paidHours    Float @default(0)  // corrected: rest breaks counted as worked
  regularHours Float @default(0)
  otHours      Float @default(0)
  doubleHours  Float @default(0)
  premiumHours Float @default(0)  // CA 226.7 meal + rest premiums owed
  // true when a workweek in this period is cut off by the pay-period boundary,
  // so its >40 overtime is provisional until the neighbouring period is known.
  partialWeek  Boolean @default(false)
  // Did this sheet render? The unsigned PDF is no longer stored - it is built
  // on demand from `data` - so `pdfUrl != null` stopped being the signal that a
  // sheet is usable, and that signal guarded something that matters: sending
  // emails 59 people a link, and a link to a sheet that cannot render is a link
  // to an error page.
  //
  // Still rendered once at upload purely to find that out, so a render failure
  // surfaces on the review screen where somebody sees it, rather than in front
  // of an employee at 6pm.
  renderOk     Boolean @default(true)
  // the full analyzed breakdown (days, punches, breaks, violations) for audit.
  data         Json

  // the generated corrected PDF
  pdfUrl      String?

  // delivery
  sentAt      DateTime?
  // the address it actually went to - in test mode this is the tester, which is
  // why intendedEmail is stored separately.
  sentToEmail String?
  intendedEmail String?
  dueAt       DateTime?
  message     String?

  // signing
  signedAt     DateTime?
  signedPdfUrl String?
  // what the signer typed/drew, for the audit trail
  signedName   String?
  signedIp     String?

  // management sign-off, after the employee has signed. the approved copy is
  // the final record - it's what the batch downloads hand back for filing.
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  approvedPdfUrl String?

  // set when the employee reports something wrong. a disputed sheet can't be
  // signed - you shouldn't attest to a document you're contesting - so this
  // holds the signature until management resolves every open correction.
  disputedAt  DateTime?
  // per-day adjustments accepted by management, keyed by the date as QSP prints
  // it: { "07/20/26": { mealViolation, restViolation, paidHours, removed } }.
  // kept separate from `data` so the original computation is never overwritten
  // and you can always see what was changed by hand.
  overrides   Json?
  // when the figures above were last recomputed from those overrides
  recomputedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  corrections TimesheetCorrection[]

  @@index([batchId])
  @@index([userId])
  @@index([signedAt])
  @@index([disputedAt])
}

// one thing an employee says is wrong with their timesheet. scoped to a single
// day where it makes sense, because that's how people actually report it ("the
// 20th is wrong"), and because accepting one has to adjust exactly one day.
// SOMEBODY HAS PUT A RED MARK ON A DATA-CHECKS ROW.
//
// Mánu 2026-08-12: "on the bottom right of each card, let's also add a little
// mark as red button that then puts whoever presses it as marked as red using
// their avatar picture." It is a working marker between the people reviewing a
// batch - "I have looked at this and it needs someone" - not a figure and not
// anything the employee ever sees.
//
// SCALARS ONLY, no relation to User or TimesheetBatch. Two reasons: the marker
// is a record of who flagged it AT THE TIME, so it should not follow a later
// rename or a changed avatar, and a row whose user is deleted should keep
// saying somebody flagged it rather than cascade away. So `batchId` does NOT
// cascade either, and `deleteBatch` clears these rows itself - unlike the
// corrections, which fall away with their own relation. Without that a deleted
// batch left its red marks behind and a re-upload could inherit them on any
// row key that happened to match.
//
// `rowKey` is the checks screen's own key for a card, which already has to be
// stable enough to be a React key across renders.
// WHERE A PERSON HAS GOT TO, on a batch two people are working through together.
//
// This was a single red mark - flagged or not - and Mánu 2026-08-13 asked for the
// states that actually describe the job: "I want it so me and Gabe can see who
// has contacted who. And, also, if we've messaged them, if they got back to us,
// so we can have record for ourselves to keep on contacting people."
//
// So the mark carries a STATUS now. "Contacted" and "No response" are different
// facts about the same message - one says it was sent, the other says it was
// sent and nothing came back - and only the second one tells you to chase.
// "Verified on QSP" is the end of the line: they fixed it and somebody looked.
//
// `flaggedName` and `flaggedImage` are copied at the moment of marking rather
// than joined, so the mark keeps saying who put it there even if that person
// later changes their photo or leaves. That is the half Mánu is asking for when
// he says "who has contacted who".
model TimesheetCheckFlag {
  id           String   @id @default(cuid())
  batchId      String
  rowKey       String
  flaggedById  String
  // "contacted" | "no-response" | "verified". Defaulted rather than nullable so
  // there is no third meaning for a row that exists with nothing on it - the
  // absence of the row IS "not started". Every row in the table predates this
  // column by zero rows, so the default rewrites nothing.
  status       String   @default("contacted")
  // HOW they were contacted: "phone" | "email", null on the states where the
  // question does not arise. Mánu 2026-08-13: "under contacted. We can choose
  // phone or email. So it can show the little phone or email icon with whoever
  // chose contacted."
  //
  // It rides on the same row rather than getting a table of its own because it
  // is one more fact about the same mark, and a mark only ever has one current
  // state. A HISTORY of every attempt is a different feature and would need one.
  via          String?
  flaggedName  String?
  flaggedImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([batchId, rowKey])
  @@index([batchId])
}

// EVERY TIME SOMEBODY WAS CONTACTED, not just the last time.
//
// Mánu 2026-08-13: "I want to log all the times we've contacted and show every
// time. In case we contact them more than once, we wanna have record of this."
//
// `TimesheetCheckFlag` holds the CURRENT state, because that is what the screens
// group and colour by and it wants one row per person to stay cheap. This holds
// the HISTORY, appended to and never updated. The two are written in one
// transaction by `setCheckFlag`, so the flag is always the newest row here
// materialised - if they ever disagree, this table is the truth, because it is
// the one nothing overwrites.
//
// CLEARING A MARK DOES NOT ERASE THE HISTORY. Taking the current state off means
// "this person is back on the pile", not "nobody ever called them" - and the
// second reading would quietly delete the record he is asking for.
// SOMEBODY WANTS EYES ON THIS ONE, and more than one person can say so.
//
// Mánu 2026-08-13: "Give a little flag icon under mark again. If you flag it,
// the card gets a red outline over it. And multiple people can flag it. And
// it'll show by who next to the flag."
//
// NOT `TimesheetCheckFlag`, despite the name, and the difference is the shape:
// that one is ONE row per person holding the current status (contacted, waiting,
// verified). This is MANY rows per person, one per reviewer, and holds no state
// beyond "I flagged this". Two people flagging the same card is the normal case
// rather than a conflict, which is exactly why it cannot live on a table with a
// unique key on (batch, row).
//
// A reviewer only ever toggles their OWN, so pressing it can never take
// somebody else's flag off the card.
model TimesheetRowFlag {
  id        String   @id @default(cuid())
  batchId   String
  // same key the status mark uses: "person-<timesheetId>" today
  rowKey    String
  userId    String
  // copied at the moment, so the flag keeps saying who raised it even if they
  // later change their photo or leave
  userName  String?
  userImage String?
  createdAt DateTime @default(now())

  // one flag per person per row. Pressing twice is an undo, not a second flag.
  @@unique([batchId, rowKey, userId])
  @@index([batchId, rowKey])
  @@index([batchId])
}

// WHAT SOMEBODY WANTS THE OTHER REVIEWER TO KNOW about this person.
//
// Mánu 2026-08-13: "I also want to add a little comment section. Underneath each
// card."
//
// The contact log answers WHAT HAPPENED and cannot hold "she says her phone is
// broken, try the email" - that is a sentence, not an event, and squeezing it
// into a status would lose it. This is the free text beside the record.
//
// INTERNAL, and it stays that way: it lives on the review screens behind
// `canManageTimesheets` and nothing renders it to an employee. It is not a
// correction, it moves no figure, and it never reaches the sheet.
//
// Kept even when the mark is cleared, for the same reason the log is: clearing
// means back on the pile, not that the conversation never happened.
model TimesheetRowComment {
  id        String   @id @default(cuid())
  batchId   String
  // same key the mark and the flag use: "person-<timesheetId>" today
  rowKey    String
  userId    String
  // copied at the moment, so a comment keeps saying who wrote it
  userName  String?
  userImage String?
  body      String
  createdAt DateTime @default(now())

  @@index([batchId, rowKey])
  @@index([batchId])
}

model TimesheetContactLog {
  id        String   @id @default(cuid())
  batchId   String
  // same key the flag uses, so a row on any of the three screens can find its
  // own history: "person-<timesheetId>" today
  rowKey    String
  // what it was set TO. "contacted" | "no-response" | "verified"
  status    String
  // "phone" | "email", only on contacted
  via       String?
  byId      String
  // copied at the moment, so an entry keeps saying who made it even if that
  // person later changes their photo or leaves
  byName    String?
  byImage   String?
  createdAt DateTime @default(now())

  @@index([batchId, rowKey])
  @@index([batchId])
}

model TimesheetCorrection {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  // the day it's about, exactly as QSP prints it ("07/20/26"). null = the whole
  // sheet (used by the catch-all "something else" kind).
  date        String?
  // see CORRECTION_KINDS in src/lib/timesheet/corrections.js
  kind        String
  // what they say they actually worked that day, when the kind calls for it
  claimedHours Float?
  note        String?
  // WHEN THEY SAY THEY TOOK THEIR BREAKS, on a day they answered "I took them".
  // [{ kindOf: "meal" | "rest", from, to, minutes, source: "typed" | "schedule" | "gap" }]
  //
  // It lives on the ANSWER rather than only in the day-row override because
  // `answerTimesheetQuestion` rebuilds every override from every answer on
  // record each time somebody replies. A time held only in the override blob is
  // lost the moment they answer a different question - which it was, until
  // 2026-08-10.
  statedBreaks Json?

  // open | accepted | declined
  status         String    @default("open")
  // THE ANSWER THEY ACTUALLY PICKED, where a kind offers more than two.
  //
  // `status` collapses everything that is not "yes" into "declined", which was
  // enough while every card had two outcomes. It is lossy for a three-outcome
  // one: `restTooLongOffClock` asks whether two lunches are both real, whether
  // the second was added by accident, or whether the ROSTERED one is the wrong
  // record - and the last two are both declines that move no figure, so on
  // reload nothing could tell them apart. The client was guessing from whether
  // times came back with the answer.
  //
  // Null on every row written before 2026-08-12, and on any answer whose status
  // already says everything - readers fall back to `status`.
  choice         String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("TimesheetCorrectionResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([timesheetId])
  @@index([status])
  @@index([createdAt])
}

// a job application submitted through the public careers form. we still email it
// to the applications inbox on submit; this stores a copy so the oversight tier
// can review them in the portal. `data` is the whole structured application (the
// same object the email is built from); the top-level columns are just for the
// list preview + sorting. `resumeUrl` is a Blob url kept server-side only - the
// resume is streamed through a gated route, never linked to the browser.
model Application {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String?
  gender     String?
  positions  String?
  startDate  String?
  resumeName String?
  resumeUrl  String?
  data       Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// "This Week in My Life Services" newsletter. staff submit items, IT +
// management approve, then IT publishes them to the public /this-week
// page. lifecycle: SUBMITTED -> APPROVED -> PUBLISHED (or REJECTED).
enum NewsletterStatus {
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

// two flavors of item: a recap of something that happened ("this past
// week") or a heads-up about something coming up.
enum NewsletterCategory {
  PAST_WEEK
  UPCOMING
}

// internal suggestions + bug reports board. staff post recommendations
// or bugs they spot (blog-post style, optional screenshot). IT/management
// triage status so items get closed out - they're not meant to live
// forever like the newsletter.
enum FeedbackType {
  SUGGESTION
  BUG
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DECLINED
}

model FeedbackItem {
  id           String         @id @default(cuid())
  type         FeedbackType
  title        String
  body         String
  imageUrl     String?
  status       FeedbackStatus @default(OPEN)
  authorId     String
  author       User           @relation("FeedbackAuthor", fields: [authorId], references: [id])
  // who marked it resolved/declined + when. null while still open.
  resolvedById String?
  resolvedBy   User?          @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

// in-portal notifications for the oversight tier. one row per recipient
// (events fan out to every oversight user), each tracking its own read state.
enum NotificationType {
  RESOURCE_PENDING
  FEEDBACK_NEW
  NEWSLETTER_PENDING
  USER_ADDED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  // in-portal path to jump to, e.g. /portal/contacts/resources/review
  link      String?
  // recipient user.
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NewsletterItem {
  id        String             @id @default(cuid())
  title     String
  body      String
  imageUrl  String?
  category  NewsletterCategory
  // optional date the event happened / will happen. shown on the public
  // page. separate from createdAt (when it was submitted).
  eventDate DateTime?
  status    NewsletterStatus   @default(SUBMITTED)
  // submitter attests written consent is on file for anyone pictured.
  // required by the server action whenever an image is attached.
  consentConfirmed Boolean      @default(false)
  // optional note from a reviewer - e.g. why something was rejected, or
  // a tweak request. shown back to the submitter.
  reviewNote String?

  submittedById String
  submittedBy   User    @relation("NLSubmittedBy", fields: [submittedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("NLApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  publishedById String?
  publishedBy   User?   @relation("NLPublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
