// Prisma schema for MLS Employee Portal.
// Standard Auth.js tables (User, Account, Session, VerificationToken)
// plus a Role enum for RBAC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  // privilege roles (controls what they can DO in the portal).
  //   SUPER:     full access to everything. hidden role - only IT can
  //              see/assign it. red badge. used for top-level superusers.
  //   ELEVATED:  IT_ADMIN, ADMIN, MANAGER  (can manage users + content)
  //   STANDARD:  HR, SUPERVISOR, STAFF      (read-only access)
  // see src/lib/roles.js for the permission helpers.
  SUPER
  IT_ADMIN
  ADMIN
  MANAGER
  HR
  SUPERVISOR
  STAFF
}

model User {
  id                           String                        @id @default(cuid())
  // full / legal name (records). managed by admin/HR. shown only on the contact
  // detail card + admin panel (gated to admin/management when hideLegalName).
  name                         String?
  // optional preferred first / last name. self-editable in settings. the name
  // shown everywhere = (preferredFirstName or legal first) + (preferredLastName
  // or legal last), e.g. "Manu" + legal last "Uribe" -> "Manu Uribe".
  preferredFirstName           String?
  preferredLastName            String?
  email                        String                        @unique
  emailVerified                DateTime?
  image                        String?
  role                         Role                          @default(STAFF)
  // job title separate from privilege role. free-form string so we can
  // add new ones without a schema migration. examples: "Owner/Director",
  // "Program Manager", "Field Supervisor", "HR Administrator", "ILS",
  // "Day Program", "Supported Living", etc.
  title                        String?
  // which office(s) they work out of, from HR's roster. "ILS" (My Life Services)
  // and/or "DP" (Day Program) - a list so someone who splits both keeps one row.
  offices                      String[]                      @default([])
  // soft delete - when set, this user cant sign in anymore. preserves
  // history (audit trails, role at time of action, etc.) rather than
  // hard deleting the row. set back to null to reactivate.
  deactivatedAt                DateTime?
  // their actual employment start date with MLS (per HR records).
  // separate from createdAt which is just when their row was added to
  // our portal db. used for tenure displays + sorting in the admin list.
  hireDate                     DateTime?
  // THE FIELD SUPERVISOR THIS PERSON REPORTS TO.
  //
  // Mánu 2026-08-23: "next week the field supervisors will be assigned to staff
  // per staff. right now its kind of random and is per client amongst the staff
  // which is just too messy."
  //
  // So the mapping is STAFF -> SUPERVISOR, one hop, and a client's supervisor is
  // whoever supervises the staff on that client's schedule. The old arrangement
  // - a supervisor picked per client - is not modelled at all, on purpose: it is
  // the thing being replaced, and carrying it would mean two answers to the same
  // question for as long as both existed.
  //
  // Starts empty for everybody and is filled in by hand. Nothing breaks while it
  // is null; an attestation with no supervisor is simply one nobody has been
  // assigned yet, and the review screen says so.
  supervisorId                 String?
  supervisor                   User?                         @relation("StaffSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervises                   User[]                        @relation("StaffSupervisor")
  // contact phone for the team directory. self-editable in Settings,
  // admins can also set it. stored as the raw string the user typed.
  phone                        String?
  // free-text working hours shown on their contact detail page, e.g.
  // "Mon-Fri 9am-5pm". self-editable in Settings, admins too.
  workingHours                 String?
  // when false, the phone is hidden on the PUBLIC shared contact link
  // (/c/[id]). still shown to signed-in staff in the portal. opt-out in
  // Settings; defaults to sharing.
  sharePhonePublicly           Boolean                       @default(true)
  // when true, the full/legal name is hidden from coworkers + the public link -
  // only the oversight tier (HR/management) + the person themselves see it.
  // self-set in settings. they should have a display name set so something
  // still shows.
  hideLegalName                Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  accounts                     Account[]
  sessions                     Session[]
  posts                        Post[]                        @relation("PostAuthor")
  postedPosts                  Post[]                        @relation("PostPostedBy")
  comments                     Comment[]
  likes                        PostLike[]
  announcements                Announcement[]                @relation("AnnouncementAuthor")
  announcementsPosted          Announcement[]                @relation("AnnouncementPostedBy")
  announcementComments         AnnouncementComment[]
  announcementLikes            AnnouncementLike[]
  announcementAcks             AnnouncementAck[]
  formSubmissions              FormSubmission[]
  announcementMeetingChoices   AnnouncementMeetingChoice[]
  announcementMeetingResponses AnnouncementMeetingResponse[]
  announcementEventRsvps       AnnouncementEventRsvp[]
  nlSubmitted                  NewsletterItem[]              @relation("NLSubmittedBy")
  nlApproved                   NewsletterItem[]              @relation("NLApprovedBy")
  nlPublished                  NewsletterItem[]              @relation("NLPublishedBy")
  feedbackAuthored             FeedbackItem[]                @relation("FeedbackAuthor")
  feedbackResolved             FeedbackItem[]                @relation("FeedbackResolvedBy")
  resourcesSubmitted           Resource[]                    @relation("ResourceSubmittedBy")
  resourcesApproved            Resource[]                    @relation("ResourceApprovedBy")
  resourcesVerified            Resource[]                    @relation("ResourceVerifiedBy")
  sitePhotos                   SitePhoto[]                   @relation("SitePhotoUploadedBy")
  notifications                Notification[]
  timesheetBatches             TimesheetBatch[]              @relation("TimesheetBatchUploadedBy")
  timesheets                   Timesheet[]                   @relation("TimesheetEmployee")
  timesheetsApproved           Timesheet[]                   @relation("TimesheetApprovedBy")
  timesheetCorrectionsResolved TimesheetCorrection[]         @relation("TimesheetCorrectionResolvedBy")
  dayProgramBatches            DayProgramBatch[]             @relation("DayProgramBatchUploadedBy")
  dayProgramSheets             DayProgramSheet[]             @relation("DayProgramEmployee")
  clientAttestationBatches     ClientAttestationBatch[]      @relation("ClientAttestationBatchUploadedBy")
  serviceNoteBatches           ServiceNoteBatch[]            @relation("ServiceNoteBatchUploadedBy")
  shiftReviews                 ShiftReview[]                 @relation("ShiftReviewDecidedBy")
  clientAttestationsAsStaff    ClientAttestation[]           @relation("ClientAttestationStaff")
  clientAttestationsSupervised ClientAttestation[]           @relation("ClientAttestationSupervisor")
  clientsAssigned              Client[]                      @relation("ClientAssignedStaff")
  clientReportsConducted       ClientReport[]                @relation("ClientReportConductedBy")
  clientAuthorizationsUploaded ClientAuthorization[]         @relation("ClientAuthorizationUploadedBy")
}

// company device / asset log. viewable by the oversight tier; editing is
// Admin and up (role-based, see src/lib/roles.js). tracks Apple + other
// hardware David purchases.
enum DeviceType {
  LAPTOP
  DESKTOP
  TABLET
  PHONE
  OTHER
}

enum DeviceStatus {
  IN_USE
  STORAGE
  REPAIR
  RETIRED
}

model Device {
  id           String       @id @default(cuid())
  name         String // e.g. "David's MacBook Pro 16"
  type         DeviceType   @default(LAPTOP)
  serialNumber String?
  // purchase price stored in whole cents to avoid float rounding.
  priceCents   Int?
  purchaseDate DateTime?
  // free text: who has it / where it lives, e.g. "David - home office".
  assignedTo   String?
  status       DeviceStatus @default(IN_USE)
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

// external partners / community resources for the team contacts page
// (e.g. Integrity Cottages, food banks, clinics). staff submit, IT or
// management approve before they show on the directory.
enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

// operational state - is the place actually running. distinct from the
// ResourceStatus above, which is the moderation/approval workflow.
enum ResourceOpStatus {
  ACTIVE
  TEMPORARILY_UNAVAILABLE
  NEEDS_VERIFICATION
  CLOSED
}

model Resource {
  id                  String           @id @default(cuid())
  name                String
  // top-level bucket shown as a chip, e.g. "Housing", "Food banks".
  category            String?
  // finer type within the category, e.g. "Food pantry", "Mobile food
  // distribution". options are per-category (see src/lib/contacts.js).
  subtype             String?
  // organization behind the location, if different from the resource name.
  orgName             String?
  phone               String?
  email               String?
  website             String?
  // direct link to book/schedule, if they take appointments online.
  appointmentLink     String?
  // free text, e.g. "Call before visiting" or "Text to schedule".
  contactInstructions String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  // who the service covers, e.g. "Anaheim residents only". free text.
  serviceArea         String?
  lat                 Float?
  lng                 Float?
  // legacy free-text hours. superseded by `schedule` for new entries but
  // kept so the imported food-bank hours still show.
  hours               String?
  // structured recurring schedule rows: [{ day, frequency, start, end }]
  schedule            Json?
  // populations served (multi). filterable. see WHO_IT_SERVES_OPTIONS.
  whoItServes         String[]         @default([])
  appointmentRequired Boolean          @default(false)
  // category-specific answers (eligibility + food details). see
  // buildDetails in src/lib/contacts.js for the shape.
  details             Json?
  // short public-facing description / what they do.
  notes               String?
  // staff-only notes, never shown to clients.
  internalNotes       String?
  // where this info came from (url, person, flyer).
  source              String?
  operationalStatus   ResourceOpStatus @default(ACTIVE)
  // featured by management - surfaces in a "Staff picks" row up top.
  staffPick           Boolean          @default(false)
  // verification trail so the directory doesn't go stale.
  lastVerifiedAt      DateTime?
  verifiedById        String?
  verifiedBy          User?            @relation("ResourceVerifiedBy", fields: [verifiedById], references: [id])
  status              ResourceStatus   @default(PENDING)
  submittedById       String
  submittedBy         User             @relation("ResourceSubmittedBy", fields: [submittedById], references: [id])
  approvedById        String?
  approvedBy          User?            @relation("ResourceApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
}

// photos shown on the public About page, managed from the portal by
// admin/IT so they can swap site imagery without a code change. uploaded
// to vercel blob; we only keep the url + a bit of metadata here.
model SitePhoto {
  id               String   @id @default(cuid())
  url              String
  // which spot on the public page: "about-hero" | "agency-overview" |
  // "partnership". validated against src/lib/site-photos.js.
  section          String
  caption          String?
  // alt text for screen readers / when the image cant load.
  alt              String?
  // order within a section (low = first). drives the slideshow order.
  sortOrder        Int      @default(0)
  // turned off to hide from the site without deleting the upload.
  active           Boolean  @default(true)
  // uploader attests a signed photo release is on file for anyone pictured.
  consentConfirmed Boolean  @default(false)
  uploadedById     String?
  uploadedBy       User?    @relation("SitePhotoUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([section, sortOrder])
}

// MLS Hub - internal feed for posts (flyers, helpful info) + comments.
// soft-deleted via deletedAt so threads dont collapse if an author leaves.
model Post {
  id         String     @id @default(cuid())
  authorId   String
  author     User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  imageUrl   String?
  // when an IT/admin posts on behalf of someone else, authorId is the
  // person being credited and postedById is who actually hit submit.
  // null when the author posted it themselves. kept for the audit trail.
  postedById String?
  postedBy   User?      @relation("PostPostedBy", fields: [postedById], references: [id])
  // tag string is validated against the list in src/lib/hub.js. kept as
  // free string so we can add new tags without a migration.
  tag        String
  // optional expiration. once past, the post shows an "Expired" badge
  // and drops below active posts in the feed.
  expiresAt  DateTime?
  // pinning is admin-only. null = not pinned. when set, post floats to
  // top of the feed.
  pinnedAt   DateTime?
  pinnedById String?
  // edit tracking. null = never edited. set explicitly by edit action.
  editedAt   DateTime?
  // soft delete. set to a timestamp by the delete action.
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  comments   Comment[]
  likes      PostLike[]

  @@index([createdAt])
  @@index([pinnedAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt])
}

// PostLike is the join table for the heart/like reaction. composite PK
// so each user can only like a post once. removing the row = unlike.
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// Announcements - a second internal feed, identical in shape to the Hub
// (Post/Comment/PostLike) but separate so it stays a clean broadcast board.
// only Supervisor+ can create announcements (see src/lib/roles.js
// isSupervisorUp); everyone reads, comments, and reacts.
model Announcement {
  id                          String                        @id @default(cuid())
  authorId                    String
  author                      User                          @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // optional title - used by the Changelog type (Discord-style heading). plain
  // announcements leave it null and just use content.
  title                       String?
  content                     String
  // ONLY VISIBLE IN THE PORTAL, 2026-08-31. Britny's CPR re-certification:
  // "we can have the code only visible through the portal too" - a link and a
  // payment code that must reach the audience and must not sit in anyone's
  // inbox. Rendered on the post page under its own heading, never included in
  // any email. Null on every post that has no such thing to hide.
  portalOnly                  String?
  imageUrl                    String?
  // proxy posting: authorId is the credited person, postedById is who hit
  // submit (null when posted by themselves). kept for the audit trail.
  postedById                  String?
  postedBy                    User?                         @relation("AnnouncementPostedBy", fields: [postedById], references: [id])
  tag                         String
  expiresAt                   DateTime?
  pinnedAt                    DateTime?
  pinnedById                  String?
  editedAt                    DateTime?
  deletedAt                   DateTime?
  // null = draft: created via "Preview", not shown in the feed, no emails sent.
  // set to now() on Publish. existing rows are backfilled to createdAt so nothing
  // already posted disappears.
  publishedAt                 DateTime?
  // SEND LATER, 2026-08-23. A draft with `publishAt` set is scheduled: the
  // meeting-jobs cron publishes it - and sends its email - once the clock
  // passes it, through the exact code the Publish button runs. Null on every
  // published post and every ordinary draft. Cleared when it fires, so a
  // scheduled post is exactly one of: waiting (publishAt set, publishedAt
  // null) or live (the reverse).
  publishAt                   DateTime?
  // what the author chose in the schedule dialog, held until the send:
  // { doEmail, everyone, titles, userIds }. The ack/meeting audience lives on
  // the post already; this is only the plain-post email choice, which
  // otherwise exists nowhere but the dialog that closed.
  publishEmail                Json?
  // when true, staff get an "I read this" box and management gets a
  // who-has/who-hasnt roster. opt-in per announcement (see requireAck box
  // on the form). plain posts leave it false.
  requireAck                  Boolean                       @default(false)
  // the acknowledgment audience - who is expected to acknowledge (drives the
  // roster denominator + the email send default). ackEveryone = the whole
  // expected-ack staff set; otherwise ackTitles lists the job titles targeted.
  ackEveryone                 Boolean                       @default(true)
  ackTitles                   String[]                      @default([])
  // specific individuals to target (in addition to ackTitles), used when the
  // poster narrows a title role to certain people. unioned with ackTitles.
  ackUserIds                  String[]                      @default([])
  // an optional fillable form attached to this announcement: acknowledging it
  // means filling + submitting the form, which writes the ack (see FormSubmission).
  formId                      String?
  form                        Form?                         @relation("AnnouncementForm", fields: [formId], references: [id])
  // POST-MEETING ATTESTATION, and it is optional on purpose: a meeting with no
  // form here still concludes, it just does not email anybody.
  meetingAttestationFormId    String?
  meetingAttestationForm      Form?                         @relation("MeetingAttestationForm", fields: [meetingAttestationFormId], references: [id])
  // the mail that goes out when the meeting is concluded. kept on the meeting so
  // the wording is decided when the meeting is written, and still editable at the
  // moment of sending - what is typed there applies to that send only.
  meetingAttestationSubject   String?
  meetingAttestationBody      String?
  // when the roll call was closed, and when the attestation actually left. two
  // stamps, not one, because a meeting with no attestation form concludes
  // without sending, and "concluded" should still mean something then.
  meetingConcludedAt          DateTime?
  meetingAttestationSentAt    DateTime?
  // DOCUMENTS THAT RIDE ALONG WITH THE POST. [{ name, url, formId?, bytes? }]
  //
  // Two sources on purpose. A `formId` entry points at something already in the
  // forms library, so the file is stored once and stays browsable at
  // /portal/forms afterwards. An entry without one was uploaded straight onto
  // the post and lives only here - which is the case that lets HR attach
  // something without waiting on a deploy, the gap that stopped Britny getting
  // the workers' comp training out on 2026-08-10.
  //
  // Json rather than a table because it is a short ordered list read only with
  // its parent, and nothing ever queries across posts by attachment.
  attachments                 Json?
  // Company Meeting fields (used when tag = "Company Meeting").
  meetingKind                 String? // Training | Team meeting | All-hands | Orientation | Other
  meetingFormat               String? // zoom | in_person | hybrid
  meetingMandatory            Boolean                       @default(false)
  zoomLink                    String?
  zoomCode                    String?
  meetingAddress              String?
  // optional sessions to pick from: [{ id, label }]. empty = single meeting.
  meetingOptions              Json?
  // when true, attendees may pick more than one session.
  // EMAIL THE AUTHOR AS SLOTS ARE PICKED. Mánu 2026-08-24, about the in-person
  // signing weeks: "an option for announcements to toggle when new people have
  // chosen slots." Flipped from the announcement page itself - not the form -
  // so it can be turned on for a meeting that is already posted or scheduled.
  // Each new pick emails the author and whoever posted on their behalf, through
  // the same off-production guard every announcement email runs.
  meetingSlotAlerts Boolean @default(false)
  meetingMultiPick            Boolean                       @default(false)
  // the meeting's start as an absolute instant (UTC). each viewer sees it in
  // their own device timezone. meetingTimezone is the zone the author set it in
  // (IANA, e.g. America/New_York) - kept for editing + a "set in" label.
  meetingAt                   DateTime?
  meetingTimezone             String?
  // duration estimate in minutes (from -> optional to for a range).
  meetingDurationFromMin      Int?
  meetingDurationToMin        Int?
  // optional "response needed by" deadline for a meeting RSVP. the auto second-
  // notice email (Phase C) fires at this instant; tz kept for the editor label.
  meetingResponseDueAt        DateTime?
  meetingResponseDueTz        String?
  // Phase C (auto-reminders): settable lead time for the "starting soon" email;
  // zoomLinkTbd = "link provided closer to the date" (attendees see a note, the
  // author gets a nudge). the *SentAt stamps keep the cron from double-firing.
  meetingReminderLeadMin      Int                           @default(10)
  zoomLinkTbd                 Boolean                       @default(false)
  // also send a "meeting tomorrow" reminder at 8pm the day before each session.
  meetingNightBefore          Boolean                       @default(true)
  meetingAuthorNudgeSentAt    DateTime?
  meetingResponseNoticeSentAt DateTime?
  meetingChoices              AnnouncementMeetingChoice[]
  meetingResponses            AnnouncementMeetingResponse[]
  meetingReminders            AnnouncementMeetingReminder[]
  // last time the "Send to staff by email" blast went out, so the roster
  // can show "last emailed ..." and re-sends only hit the un-acked.
  ackEmailSentAt              DateTime?
  // Event fields (used when tag = "Event"). audience = "employee" (staff
  // get-together) or "client" (staff + clients, e.g. a BBQ). one date + optional
  // end, a venue name + address for the map embed. staff RSVP for a headcount;
  // on client events they also say how many clients they're bringing.
  eventAudience               String?
  eventAt                     DateTime?
  eventTimezone               String?
  eventEndAt                  DateTime?
  eventLocationName           String?
  eventAddress                String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  comments                    AnnouncementComment[]
  likes                       AnnouncementLike[]
  acks                        AnnouncementAck[]
  eventRsvps                  AnnouncementEventRsvp[]

  @@index([createdAt])
  @@index([pinnedAt])
}

// one person's RSVP to an Event, for a headcount. going = they're coming;
// clientCount = how many clients they're bringing (client events only). one row
// per person (composite PK).
model AnnouncementEventRsvp {
  announcementId String
  userId         String
  going          Boolean      @default(true)
  clientCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// read-receipt for an ack-required announcement. one row per person who
// acknowledged, composite PK so each person acks once. mirrors
// AnnouncementLike. viaEmail records whether they clicked the one-click
// email link or checked the box in the portal.
model AnnouncementAck {
  announcementId String
  userId         String
  viaEmail       Boolean      @default(false)
  // set when an admin logged the acknowledgment on someone's behalf (out sick,
  // tech trouble, etc). null = the person acknowledged it themselves. plain id,
  // resolved to a name at render time so we can show "recorded by X".
  recordedById   String?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([announcementId, createdAt])
}

model AnnouncementLike {
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// a person's pick(s) for a Company Meeting's session options. one row per
// chosen option, so a user can pick several when meetingMultiPick is on; the
// composite PK keeps each (user, option) unique. drives the who-picked-what
// roster.
model AnnouncementMeetingChoice {
  announcementId String
  userId         String
  optionId       String
  // per-session roll-call: "present" / "absent" / null (not marked). used for
  // multi-session + series meetings so each session tracks its own attendance;
  // single-session meetings keep using AnnouncementMeetingResponse.attended.
  attended       String?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId, optionId])
}

// a person's overall response to a Company Meeting: going, or cant make it (with
// an optional reason). one row per (announcement, user) - the row existing means
// they responded, which also counts as their acknowledgment. which session(s)
// theyre going to lives in AnnouncementMeetingChoice. drives the Going / Cant
// make it / No response roster.
model AnnouncementMeetingResponse {
  announcementId String
  userId         String
  cantMakeIt     Boolean      @default(false)
  reason         String?
  // roll-call (Phase B): admin marks "present" / "absent" on the day. null =
  // not yet marked. attendance is meeting-level (the session they picked).
  attended       String?
  // true when the response was last recorded through a one-click email link
  // (no login), so the attendance report can show how it came in.
  viaEmail       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

// idempotency for the Phase C "starting soon" reminder: one row per session that
// has been reminded (optionId = "" for a single-session meeting). the cron
// checks this before sending so a 5-min poll never double-fires. survives edits.
model AnnouncementMeetingReminder {
  announcementId String
  optionId       String       @default("")
  // which reminder: "soon" (lead-min before) or "night" (8pm the day before).
  kind           String       @default("soon")
  sentAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, optionId, kind])
}

// the Forms library - a managed list of blank form templates (PDFs). staff
// browse + download; fillable PDFs (AcroForm) can be filled in the browser and
// downloaded/sent. NO filled-in copies are ever stored here - only the blank
// templates. fileUrl points at a public /forms/* path or a Vercel Blob URL.
model Form {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String?
  fileUrl     String
  // true when the PDF has AcroForm fields, so it can be filled in-app.
  fillable    Boolean  @default(false)
  // random, unguessable id for the public /f/<slug> share link (so the link is
  // only reachable if it's shared, not by guessing the readable form id).
  shareSlug   String?  @unique
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions   FormSubmission[]
  announcements Announcement[]  @relation("AnnouncementForm")
  // meetings that ask for this form to be signed once they have concluded
  attestationFor Announcement[] @relation("MeetingAttestationForm")

  @@index([category])
}

// a stored, signed form submission - the durable record behind the forms admin
// panel + retention, and (when tied to an announcement) the proof that completes
// an acknowledgment. the signed PDF lives in Blob under an unguessable key and is
// streamed back through a gated route, never linked to the browser.
model FormSubmission {
  id             String   @id @default(cuid())
  formId         String
  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  // set when this submission fulfills an announcement's required acknowledgment
  announcementId String?
  // who it's attributed to: set immediately for signed-in submits; set later for
  // no-login submits (email-match or a manual assign in the admin panel).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // how it got attributed: signed-in | email-match | assigned | unassigned
  attribution    String   @default("unassigned")
  // what the submitter typed - drives reconciliation for no-login submits
  submitterName  String
  submitterEmail String
  pdfUrl         String
  pdfName        String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([formId, createdAt])
  @@index([announcementId])
  @@index([userId])
}

// one upload of the QSP "Simple Timesheet" export - a single PDF holding every
// employee for a pay period. parsing it produces one Timesheet row per person.
model TimesheetBatch {
  id String @id @default(cuid())

  // A BATCH THAT MAY ONLY EVER EMAIL ONE ADDRESS.
  //
  // Kept as a strict rehearsal: every rule holds exactly as it does on a live
  // batch - the Send all safeguard, the final and superseded refusals, the
  // signing gate, the whole question set - and the ONE thing that differs is
  // where a message can go. Both the employee emails and the problem alert that
  // comes to us are forced to `testEmail`.
  //
  // A COLUMN AND NOT A LIST OF IDS IN CODE, because every upload creates a new
  // batch row and an id in a source file stops meaning anything the moment the
  // period is re-uploaded - the same failure that stranded 70 marks and is why
  // `markKey` exists.
  testOnly       Boolean   @default(false)
  testEmail      String?
  // WHICH PROGRAM'S PAYROLL THIS IS. "MLS" for the agency, "DP" for the day
  // program, and the default makes every batch that predates the column an
  // explicit MLS one. The group key on the timesheets screen and supersededBy
  // both include it, so the two programs' batches of the same fortnight are
  // two cards and neither can supersede the other.
  program        String    @default("MLS")
  // day program only, null on MLS forever: the hand-maintained rest break
  // audit xlsx that confirms the 2nd breaks typed into DSN summaries - its
  // blob url plus everything its reader flagged for a person to look at.
  dpAudit        Json?
  // day program only: the Employee Mileage Tracking Report (.xls). The agency's
  // batches take their miles off the Simple Payroll Processing Report, which
  // the day program has no equivalent of - so its mileage arrives as its own
  // export and lands here. Kept for the same reason every other source is: the
  // figure is printed under the totals on a sheet somebody signs and attests
  // to, and a number on a signed document nobody can trace is worth less than
  // no number at all.
  dpMileageUrl   String?
  dpMileageName  String?
  // the pay period exactly as QSP printed it, e.g. "07/16/26" / "07/31/26".
  periodFrom     String
  periodTo       String
  // the uploaded source PDF, kept for audit (Blob, streamed back through a
  // gated route like every other stored document here).
  sourceUrl      String?
  sourceName     String?
  // the Employee Schedules calendar PDF, when one was uploaded alongside. it's
  // the second opinion the checks screen leans on, and until now it was parsed
  // in memory and thrown away - so the screen could say "schedule has 74.30"
  // with no way for anyone to check that reading against the document.
  scheduleUrl    String?
  scheduleName   String?
  // the QSClock Time and Attendance export. the only source that separates a
  // punch someone clocked from one typed in afterwards, which is what decides
  // whether a premium can be signed off or needs a person to look at it.
  clockUrl       String?
  clockName      String?
  // THE THREE NOTES EXPORTS, 2026-08-27. Mánu: "i want to be able to upload all
  // of this info just to the timesheets page. and the audit card and more to
  // come can just get it from that info ... i also want to do it by timesheet
  // pay period."
  //
  // All three optional, like the clock export: a period should still upload
  // when one of them is not ready, and absent means nothing was documented
  // ONE WAY, never that nothing was documented.
  //
  // The Employee Detailed Daily Service Notes PDF - what staff wrote about each
  // visit. Its parsed notes live in `BatchServiceNotes` rather than here,
  // because reading them back costs 1.5 seconds against this .xls's 68ms.
  notesUrl          String?
  notesName         String?
  // The Employee Service Notes .xls - THE OTHER PLACE A NOTE GETS WRITTEN.
  // Field Supervisors do not file Daily Service Notes; they write here and in
  // the schedule notes, which is why both exports are needed and neither is a
  // broken version of the other. Read back off Blob per page view, like the
  // clock export.
  serviceNotesUrl   String?
  serviceNotesName  String?
  // The Employee Schedule Notes .xls - the reason staff typed when a shift did
  // not run as booked. The timesheet's own Comments Details block carries the
  // same notes; this one names the client on 256 of 290, which is what lets a
  // reason be handed to one booking rather than to the whole day.
  scheduleNotesUrl  String?
  scheduleNotesName String?
  // the Rest Periods Report. decides whether a rest break was actually taken,
  // which is what the bigger half of the premium total turns on.
  //
  // NOT COLLECTED SINCE 2026-08-06, when the export set was cut to three
  // reports. Kept, along with the clock columns above, because the decision was
  // "hold for now, we may add it back" - and dropping the columns would mean a
  // second migration to undo. Existing batches still hold theirs.
  restsUrl       String?
  restsName      String?
  // SUPERSEDED by restsByDate, which holds these rows and every other one.
  // Left in place rather than dropped in a second migration; nothing writes it
  // any more and it can go whenever the schema is next touched.
  restsAttention Json?
  // EVERY row of that report, from `rests.allRestRows()`: the recorded out and
  // in times, the length, whether it counted, and why if not.
  //
  // The times are the point. The signed sheet colours only what the two reports
  // actually recorded - a punch gap is not evidence of a break - and a properly
  // taken rest is PAID and stays ON the clock, so it leaves no gap to colour.
  // 204 of the 226 days carrying a rest have no punch gap at all, which is why
  // a count was never going to be enough.
  //
  // Stored on the BATCH because the report is one document covering everyone.
  // Nullable: batches uploaded before this column exists have nothing here.
  restsByDate    Json?
  // WHAT THE QSCLOCK EXPORT OBSERVED, and it is observation only.
  //
  // Mánu 2026-08-22: "the qsp attendance report shouldnt touch anything at all.
  // it is purely for observing." So nothing this export produces is written to a
  // Timesheet row - not the findings, not its own match, not the spelling it
  // matched somebody under. It all lives here, on the batch, exactly as
  // `restsByDate` above holds a whole report for the same reason: one document
  // covering everybody.
  //
  // Keyed by the timesheet's own spelling of each name, so a screen holding a
  // sheet can find its row without the clock export having stamped anything on
  // that sheet.
  //
  // Nullable, and absent is not zero: a batch uploaded with no clock export has
  // nothing to say about clocking, which is a different fact from everybody
  // having clocked.
  clockFindings  Json?
  // the Simple Payroll Processing Report (.xls). one row per employee carrying
  // QSP's OWN regular, overtime and double-time figures - the numbers payroll
  // actually runs on. This is what settles an overtime disagreement without
  // anybody re-reading a PDF, and it reconciles with the timesheet exactly.
  payrollUrl     String?
  payrollName    String?
  // whether sends from this batch were redirected to the test inbox. recorded
  // per batch so a test run can never be mistaken for a real one later.
  testMode       Boolean   @default(true)
  // uploaded before the pay period ended, with the days that had not happened
  // yet dropped. Recorded for the same reason testMode is: this batch's hours
  // are a partial record, its last workweek is cut off mid-week, and nothing
  // else on the batch would say so afterwards.
  partialPeriod  Boolean   @default(false)
  // the first and last day that actually survived the trim, e.g. "08/01/26" and
  // "08/09/26". periodFrom/periodTo still say what QSP printed on the export,
  // because that is what the document says - and on a partial upload the two
  // disagree on purpose, since QSP returns the whole period whatever range it
  // was asked for.
  partialFrom    String?
  partialThrough String?
  // SOMEBODY HAS SAID THIS UPLOAD IS FINAL AND THE SCHEDULE IS LOCKED.
  //
  // Locked means the schedule can no longer be changed, and it happens around
  // 8pm on the last day of the period. NOTHING IN ANY OF THE FOUR EXPORTS SAYS
  // SO - not the timesheet, not the schedule PDF, not the clock export, not the
  // rest report - so this cannot be detected and has to be attested.
  //
  // The portal detects the PRECONDITION on its own: when the data reaches the
  // last day of the period there is something worth asking about. It then asks
  // rather than assumes, because an upload at 7:45pm and one at 8:15pm look
  // identical from here and only one of them is safe.
  //
  // Cleared by a later upload of the same period, since the question was about
  // THAT export being the final one.
  //
  // Scalars, no relation, for the same reason the check flags are scalars: this
  // records who said it AT THE TIME and should not follow a later rename or
  // cascade away with a deleted account.
  lockedAt       DateTime?
  lockedById     String?
  lockedByName   String?

  uploadedById String
  uploadedBy   User        @relation("TimesheetBatchUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  timesheets   Timesheet[]
  serviceNotes BatchServiceNotes?

  @@index([createdAt])
}

// THE SERVICE NOTES OF ONE PAY PERIOD, PARSED, 2026-08-27.
//
// A row of its own rather than a column on TimesheetBatch, for the reason the
// clock rows are NOT stored at all: the notes of a fortnight are about a
// megabyte, and Repeat patterns loads every batch there has ever been. A
// megabyte per period on that table is seventeen on a screen printing twelve
// dates.
//
// Stored rather than re-read, unlike the clock export, because the source is a
// PDF: 1.5 seconds to parse against the clock's 8ms. The two .xls exports are
// fast enough to read back off Blob on each page view and are not kept here.
//
// One row per batch, so a re-upload of a period replaces its notes with the
// notes of the export that came with it, and deleting a batch takes them.
//
// SUPERSEDES ServiceNoteBatch, which had its own upload and its own date range.
// That table is left in place until 08/01-08/15 is re-uploaded through the
// timesheets page; nothing writes it any more.
model BatchServiceNotes {
  id String @id @default(cuid())

  batchId String         @unique
  batch   TimesheetBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // every note of the period, the PDF's and the .xls's merged - see
  // `mergeNotes` in service-notes-xls.js. A note carries which export it came
  // off, because only the PDF records who signed it and when.
  notes Json

  noteCount    Int @default(0)
  // how many came off each report, so a period that is short on one of them is
  // visible without counting a megabyte of JSON
  pdfCount     Int @default(0)
  serviceCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// one employee's corrected timesheet for a pay period: the computed figures, the
// generated PDF, who it went to, and the signed copy that comes back.
model Timesheet {
  id          String         @id @default(cuid())
  batchId     String
  batch       TimesheetBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // the name exactly as QSP printed it, e.g. "Miranda, Gabriel". kept even after
  // matching so the operator can always see what the source said.
  sourceName  String
  // the matched portal account. null until someone is picked - nothing sends
  // without it.
  userId      String?
  user        User?          @relation("TimesheetEmployee", fields: [userId], references: [id], onDelete: SetNull)
  // how the match happened: exact | fuzzy | manual | unmatched
  matchMethod String         @default("unmatched")

  // computed figures (also in `data`, duplicated here for lists + sorting)
  rawHours     Float   @default(0) // as exported by QSP
  paidHours    Float   @default(0) // corrected: rest breaks counted as worked
  regularHours Float   @default(0)
  otHours      Float   @default(0)
  doubleHours  Float   @default(0)
  premiumHours Float   @default(0) // CA 226.7 meal + rest premiums owed
  // true when a workweek in this period is cut off by the pay-period boundary,
  // so its >40 overtime is provisional until the neighbouring period is known.
  partialWeek  Boolean @default(false)
  // Did this sheet render? The unsigned PDF is no longer stored - it is built
  // on demand from `data` - so `pdfUrl != null` stopped being the signal that a
  // sheet is usable, and that signal guarded something that matters: sending
  // emails 59 people a link, and a link to a sheet that cannot render is a link
  // to an error page.
  //
  // Still rendered once at upload purely to find that out, so a render failure
  // surfaces on the review screen where somebody sees it, rather than in front
  // of an employee at 6pm.
  renderOk     Boolean @default(true)
  // the full analyzed breakdown (days, punches, breaks, violations) for audit.
  data         Json

  // the generated corrected PDF
  pdfUrl String?

  // delivery
  sentAt        DateTime?
  // the address it actually went to - in test mode this is the tester, which is
  // why intendedEmail is stored separately.
  sentToEmail   String?
  intendedEmail String?
  dueAt         DateTime?
  message       String?

  // signing
  signedAt     DateTime?
  signedPdfUrl String?
  // WHO SIGNED, for the audit trail. A typed name where one is ever collected,
  // otherwise the person the token was issued to, resolved when they sign. The
  // signature they DREW lives in `signedPdfUrl`; this is the readable half, and
  // it was null on every signature until 2026-08-17 because the only path that
  // set it was the public share-link flow.
  signedName   String?
  signedIp     String?

  // management sign-off, after the employee has signed. the approved copy is
  // the final record - it's what the batch downloads hand back for filing.
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  approvedPdfUrl String?

  // set when the employee reports something wrong. a disputed sheet can't be
  // signed - you shouldn't attest to a document you're contesting - so this
  // holds the signature until management resolves every open correction.
  disputedAt   DateTime?
  // per-day adjustments accepted by management, keyed by the date as QSP prints
  // it: { "07/20/26": { mealViolation, restViolation, paidHours, removed } }.
  // kept separate from `data` so the original computation is never overwritten
  // and you can always see what was changed by hand.
  overrides    Json?
  // when the figures above were last recomputed from those overrides
  recomputedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  corrections TimesheetCorrection[]

  @@index([batchId])
  @@index([userId])
  @@index([signedAt])
  @@index([disputedAt])
}

// one thing an employee says is wrong with their timesheet. scoped to a single
// day where it makes sense, because that's how people actually report it ("the
// 20th is wrong"), and because accepting one has to adjust exactly one day.
// SOMEBODY HAS PUT A RED MARK ON A DATA-CHECKS ROW.
//
// Mánu 2026-08-12: "on the bottom right of each card, let's also add a little
// mark as red button that then puts whoever presses it as marked as red using
// their avatar picture." It is a working marker between the people reviewing a
// batch - "I have looked at this and it needs someone" - not a figure and not
// anything the employee ever sees.
//
// SCALARS ONLY, no relation to User or TimesheetBatch. Two reasons: the marker
// is a record of who flagged it AT THE TIME, so it should not follow a later
// rename or a changed avatar, and a row whose user is deleted should keep
// saying somebody flagged it rather than cascade away. So `batchId` does NOT
// cascade either, and `deleteBatch` clears these rows itself - unlike the
// corrections, which fall away with their own relation. Without that a deleted
// batch left its red marks behind and a re-upload could inherit them on any
// row key that happened to match.
//
// `rowKey` is the checks screen's own key for a card, which already has to be
// stable enough to be a React key across renders.
// WHERE A PERSON HAS GOT TO, on a batch two people are working through together.
//
// This was a single red mark - flagged or not - and Mánu 2026-08-13 asked for the
// states that actually describe the job: "I want it so me and Gabe can see who
// has contacted who. And, also, if we've messaged them, if they got back to us,
// so we can have record for ourselves to keep on contacting people."
//
// So the mark carries a STATUS now. "Contacted" and "No response" are different
// facts about the same message - one says it was sent, the other says it was
// sent and nothing came back - and only the second one tells you to chase.
// "Verified on QSP" is the end of the line: they fixed it and somebody looked.
//
// `flaggedName` and `flaggedImage` are copied at the moment of marking rather
// than joined, so the mark keeps saying who put it there even if that person
// later changes their photo or leaves. That is the half Mánu is asking for when
// he says "who has contacted who".
model TimesheetCheckFlag {
  id           String  @id @default(cuid())
  batchId      String
  rowKey       String
  flaggedById  String
  // "contacted" | "no-response" | "verified". Defaulted rather than nullable so
  // there is no third meaning for a row that exists with nothing on it - the
  // absence of the row IS "not started". Every row in the table predates this
  // column by zero rows, so the default rewrites nothing.
  status       String  @default("contacted")
  // HOW they were contacted: "phone" | "email", null on the states where the
  // question does not arise. Mánu 2026-08-13: "under contacted. We can choose
  // phone or email. So it can show the little phone or email icon with whoever
  // chose contacted."
  //
  // It rides on the same row rather than getting a table of its own because it
  // is one more fact about the same mark, and a mark only ever has one current
  // state. A HISTORY of every attempt is a different feature and would need one.
  via          String?
  flaggedName  String?
  flaggedImage String?

  // ---- THE KEY THAT OUTLIVES AN UPLOAD ----------------------------------
  //
  // `batchId` + `rowKey` cannot. Every upload makes a new batch row and new
  // timesheet rows, and rowKey carries a timesheet id, so a mark is orphaned
  // twice over the next morning. It has already happened: 70 marks made on the
  // 08/01-08/09 batch vanished the moment the 08/01-08/12 export landed, and
  // all 60 people carried over perfectly while not one mark did.
  //
  // The three below identify a mark by what it is ABOUT rather than by which
  // upload it was made on:
  //
  //   period      QSP's own "Pay Period:" line, so two uploads of one fortnight
  //               are one period. Semi-monthly: 1st-15th, then 16th to the end.
  //   personKey   the account. 239 of 239 sheets across all four batches have
  //               one, so it never falls back to matching names - which is what
  //               files Delgado Pineda, Ruth under "Angel".
  //   findingKey  what the finding is, with no id in it. `person`,
  //               `overlap-08/07/26`, `rest-late-08/03/26`.
  //
  // NULLABLE, and `batchId`/`rowKey` are kept rather than dropped, because
  // production is whatever is on `main`: a column the deployed code does not
  // know about must not be the only place the answer lives. They are backfilled
  // by a script rather than by the migration, so the write can be read first.
  // same program scoping as TimesheetBreakAnswer, same reason: marks are
  // read by (period, person, finding) and two payrolls share both the
  // periods and, occasionally, the people.
  program    String  @default("MLS")
  periodFrom String?
  periodTo   String?
  personKey  String?
  findingKey String?

  // HOW FAR THE DATA REACHED WHEN THIS WAS MARKED, as QSP prints a date.
  //
  // "Contacted" has to mean "I went through everything they had as of the 12th",
  // not "I sent them a message". Without it, tomorrow's upload adds a finding
  // and the old mark silently claims to cover it. With it, a new day can add
  // something to raise without disturbing what was already settled.
  coveredThrough String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, rowKey])
  @@index([batchId])
  @@index([periodFrom, periodTo, personKey])
}

// EVERY TIME SOMEBODY WAS CONTACTED, not just the last time.
//
// Mánu 2026-08-13: "I want to log all the times we've contacted and show every
// time. In case we contact them more than once, we wanna have record of this."
//
// `TimesheetCheckFlag` holds the CURRENT state, because that is what the screens
// group and colour by and it wants one row per person to stay cheap. This holds
// the HISTORY, appended to and never updated. The two are written in one
// transaction by `setCheckFlag`, so the flag is always the newest row here
// materialised - if they ever disagree, this table is the truth, because it is
// the one nothing overwrites.
//
// CLEARING A MARK DOES NOT ERASE THE HISTORY. Taking the current state off means
// "this person is back on the pile", not "nobody ever called them" - and the
// second reading would quietly delete the record he is asking for.
// SOMEBODY WANTS EYES ON THIS ONE, and more than one person can say so.
//
// Mánu 2026-08-13: "Give a little flag icon under mark again. If you flag it,
// the card gets a red outline over it. And multiple people can flag it. And
// it'll show by who next to the flag."
//
// NOT `TimesheetCheckFlag`, despite the name, and the difference is the shape:
// that one is ONE row per person holding the current status (contacted, waiting,
// verified). This is MANY rows per person, one per reviewer, and holds no state
// beyond "I flagged this". Two people flagging the same card is the normal case
// rather than a conflict, which is exactly why it cannot live on a table with a
// unique key on (batch, row).
//
// A reviewer only ever toggles their OWN, so pressing it can never take
// somebody else's flag off the card.
model TimesheetRowFlag {
  id        String   @id @default(cuid())
  batchId   String
  // same key the status mark uses: "person-<timesheetId>" today
  rowKey    String
  userId    String
  // copied at the moment, so the flag keeps saying who raised it even if they
  // later change their photo or leave
  userName  String?
  userImage String?
  createdAt DateTime @default(now())

  // one flag per person per row. Pressing twice is an undo, not a second flag.
  @@unique([batchId, rowKey, userId])
  @@index([batchId, rowKey])
  @@index([batchId])
}

// WHAT SOMEBODY WANTS THE OTHER REVIEWER TO KNOW about this person.
//
// Mánu 2026-08-13: "I also want to add a little comment section. Underneath each
// card."
//
// The contact log answers WHAT HAPPENED and cannot hold "she says her phone is
// broken, try the email" - that is a sentence, not an event, and squeezing it
// into a status would lose it. This is the free text beside the record.
//
// INTERNAL, and it stays that way: it lives on the review screens behind
// `canManageTimesheets` and nothing renders it to an employee. It is not a
// correction, it moves no figure, and it never reaches the sheet.
//
// Kept even when the mark is cleared, for the same reason the log is: clearing
// means back on the pile, not that the conversation never happened.
model TimesheetRowComment {
  id        String   @id @default(cuid())
  batchId   String
  // same key the mark and the flag use: "person-<timesheetId>" today
  rowKey    String
  userId    String
  // copied at the moment, so a comment keeps saying who wrote it
  userName  String?
  userImage String?
  body      String
  createdAt DateTime @default(now())

  @@index([batchId, rowKey])
  @@index([batchId])
}

model TimesheetContactLog {
  id      String  @id @default(cuid())
  batchId String
  // same key the flag uses, so a row on any of the three screens can find its
  // own history: "person-<timesheetId>" today
  rowKey  String
  // what it was set TO. "contacted" | "no-response" | "verified"
  status  String
  // "phone" | "email", only on contacted
  via     String?
  byId    String
  // copied at the moment, so an entry keeps saying who made it even if that
  // person later changes their photo or leaves
  byName  String?
  byImage String?

  // the same key as the mark it belongs to - see TimesheetCheckFlag. The log is
  // the half that must NOT be lost on a re-upload: a mark can be re-made, but
  // "we rang them on the 12th and again on the 13th" cannot be reconstructed
  // from anything. 12 of these events were already stranded.
  // scoped like the mark it records: the contact history is read by period,
  // and two payrolls share both the fortnights and, sometimes, the people.
  program    String  @default("MLS")
  periodFrom String?
  periodTo   String?
  personKey  String?
  findingKey String?

  createdAt DateTime @default(now())

  @@index([batchId, rowKey])
  @@index([batchId])
  @@index([periodFrom, periodTo, personKey])
}

model TimesheetCorrection {
  id           String    @id @default(cuid())
  timesheetId  String
  timesheet    Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  // the day it's about, exactly as QSP prints it ("07/20/26"). null = the whole
  // sheet (used by the catch-all "something else" kind).
  date         String?
  // see CORRECTION_KINDS in src/lib/timesheet/corrections.js
  kind         String
  // what they say they actually worked that day, when the kind calls for it
  claimedHours Float?
  note         String?
  // WHEN THEY SAY THEY TOOK THEIR BREAKS, on a day they answered "I took them".
  // [{ kindOf: "meal" | "rest", from, to, minutes, source: "typed" | "schedule" | "gap" }]
  //
  // It lives on the ANSWER rather than only in the day-row override because
  // `answerTimesheetQuestion` rebuilds every override from every answer on
  // record each time somebody replies. A time held only in the override blob is
  // lost the moment they answer a different question - which it was, until
  // 2026-08-10.
  statedBreaks Json?

  // THE QUESTION AS IT WAS ASKED, frozen at the moment it was answered.
  //
  // The review page can only draw a card for a question `buildQuestions` still
  // emits, and an answer that resolves its finding DELETES ITS OWN QUESTION -
  // so answering made the card vanish, and with it any way to correct a
  // mis-click. Every premium-bearing issue has to stay on that page and stay
  // changeable until the signature, because the correction usually happens on
  // a phone call and the employee has to watch it land before signing.
  //
  // Rebuilding the question from `data.daysOriginal` was measured and does not
  // work: on the July sheet the answered miscTime question is absent from the
  // pristine days too, because `miscBlocks` postdates that snapshot. So the
  // answer carries what it was answering rather than anything trying to infer
  // it afterwards.
  //
  // Null on every row written before 2026-08-16 - four of them, all on the
  // July test batch.
  question Json?

  // open | accepted | declined
  status String  @default("open")
  // THE ANSWER THEY ACTUALLY PICKED, where a kind offers more than two.
  //
  // `status` collapses everything that is not "yes" into "declined", which was
  // enough while every card had two outcomes. It is lossy for a three-outcome
  // one: `restTooLongOffClock` asks whether two lunches are both real, whether
  // the second was added by accident, or whether the ROSTERED one is the wrong
  // record - and the last two are both declines that move no figure, so on
  // reload nothing could tell them apart. The client was guessing from whether
  // times came back with the answer.
  //
  // Null on every row written before 2026-08-12, and on any answer whose status
  // already says everything - readers fall back to `status`.
  choice String?

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("TimesheetCorrectionResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timesheetId])
  @@index([status])
  @@index([createdAt])
}

// a job application submitted through the public careers form. we still email it
// to the applications inbox on submit; this stores a copy so the oversight tier
// can review them in the portal. `data` is the whole structured application (the
// same object the email is built from); the top-level columns are just for the
// list preview + sorting. `resumeUrl` is a Blob url kept server-side only - the
// resume is streamed through a gated route, never linked to the browser.
model Application {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String?
  gender     String?
  positions  String?
  startDate  String?
  resumeName String?
  resumeUrl  String?
  data       Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// "This Week in My Life Services" newsletter. staff submit items, IT +
// management approve, then IT publishes them to the public /this-week
// page. lifecycle: SUBMITTED -> APPROVED -> PUBLISHED (or REJECTED).
enum NewsletterStatus {
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

// two flavors of item: a recap of something that happened ("this past
// week") or a heads-up about something coming up.
enum NewsletterCategory {
  PAST_WEEK
  UPCOMING
}

// internal suggestions + bug reports board. staff post recommendations
// or bugs they spot (blog-post style, optional screenshot). IT/management
// triage status so items get closed out - they're not meant to live
// forever like the newsletter.
enum FeedbackType {
  SUGGESTION
  BUG
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DECLINED
}

model FeedbackItem {
  id           String         @id @default(cuid())
  type         FeedbackType
  title        String
  body         String
  imageUrl     String?
  status       FeedbackStatus @default(OPEN)
  authorId     String
  author       User           @relation("FeedbackAuthor", fields: [authorId], references: [id])
  // who marked it resolved/declined + when. null while still open.
  resolvedById String?
  resolvedBy   User?          @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

// in-portal notifications for the oversight tier. one row per recipient
// (events fan out to every oversight user), each tracking its own read state.
enum NotificationType {
  RESOURCE_PENDING
  FEEDBACK_NEW
  NEWSLETTER_PENDING
  USER_ADDED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  // in-portal path to jump to, e.g. /portal/contacts/resources/review
  link      String?
  // recipient user.
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NewsletterItem {
  id               String             @id @default(cuid())
  title            String
  body             String
  imageUrl         String?
  category         NewsletterCategory
  // optional date the event happened / will happen. shown on the public
  // page. separate from createdAt (when it was submitted).
  eventDate        DateTime?
  status           NewsletterStatus   @default(SUBMITTED)
  // submitter attests written consent is on file for anyone pictured.
  // required by the server action whenever an image is attached.
  consentConfirmed Boolean            @default(false)
  // optional note from a reviewer - e.g. why something was rejected, or
  // a tweak request. shown back to the submitter.
  reviewNote       String?

  submittedById String
  submittedBy   User      @relation("NLSubmittedBy", fields: [submittedById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("NLApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  publishedById String?
  publishedBy   User?     @relation("NLPublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// WHY A BREAK WAS NOT TAKEN, recorded by whoever asked them.
//
// QSP has no field for this. The rest report's Schedule Notes are about late
// clock-ins - "forgot to punch in", "traffic", "accidental late clock in" - and
// the timesheet's comments block is the same field's sibling, time-ranged
// against a shift. Not one of the four exports carries a reason for a missed
// meal or rest, so every one of these is gathered fresh: from a call, a text,
// or from what the employee writes on their own page.
//
// KEYED ON (period, person, finding) FROM THE FIRST DAY, not on the timesheet.
// Corrections are timesheet-scoped and die on every re-upload, which is exactly
// what stranded 70 contact marks. A reason taken off a phone call must not
// evaporate because a new export landed.
//
// TWO ANSWERS, and they behave oppositely on the next upload:
//
//   not-taken  they confirm they did not take it. There is nothing to punch, so
//              the finding will still be there on every future export and must
//              read as settled rather than as them failing to act.
//   took-it    they say they took it and it is not punched. THAT is a QSP fix,
//              and the next export either shows it or does not.
model TimesheetBreakAnswer {
  id         String @id @default(cuid())
  // WHICH PAYROLL. Both programs run the same fortnights with, sometimes, the
  // SAME person - Velasquez works both - and his 08/13 rest finding carries
  // the same findingKey on both sides. Without this in the key, an answer
  // taken on the day program side would overwrite what his live MLS sheet
  // displays above a pending signature. Default MLS: every row that predates
  // the column was an MLS answer.
  program    String @default("MLS")
  periodFrom String
  periodTo   String
  personKey  String
  findingKey String

  // kept for reading and for printing on the sheet, so nothing has to be
  // recovered by parsing the finding key back apart
  date   String?
  kind   String
  answer String

  // WHY. Null means nobody gathered one, and that is not a blank field - it is
  // the state that moves the question to the employee, whose timesheet does not
  // generate until they answer it.
  reason String?
  // how we heard it: "phone" | "email" | "in-person"
  via    String?

  // HOW MANY OF THEM THEY TOOK, and how many the day was short.
  //
  // A meal is one thing. A rest violation is "0 of 2 recorded", and the honest
  // answers span the range: neither, or one of the two. Two buttons cannot say
  // that, so the answer carries a count and the control offers every
  // possibility the day allows. Null on a meal, which has nothing to count.
  takenCount   Int?
  missingCount Int?

  // scalars, like the check flags: this records who took the answer AT THE TIME
  // and must not follow a later rename or cascade away with an account.
  byId    String
  byName  String?
  byImage String?

  // set when the employee has seen our wording and agreed it. Their own
  // correction, when they disagree, is a second row rather than an overwrite -
  // both go on the printed sheet.
  confirmedAt   DateTime?
  confirmedText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([program, periodFrom, periodTo, personKey, findingKey])
  @@index([periodFrom, periodTo, personKey])
}

// ---------------------------------------------------------------- day program
//
// THROWAWAY, AND MEANT TO BE. The day program has no QSP export set: no Simple
// Timesheet, no schedule PDF, no payroll report, no clock export. What it has
// is one hand-maintained spreadsheet, the Rest Break Period Report, and these
// two tables exist to get signable sheets out of it while a real system is
// built. Dropping the feature is one migration and deleting
// src/lib/day-program plus the route folder.
//
// DELIBERATELY NOT TimesheetBatch, and that is the whole reason these exist.
// The timesheets screen groups its cards by `periodFrom..periodTo`, so a day
// program upload of 08/01/26-08/15/26 would become the newest batch of that
// period, take the card, and flip the live 60-sheet MLS batch to SUPERSEDED. A
// separate table cannot do that to it.
model DayProgramBatch {
  id         String @id @default(cuid())
  // the window the report actually covers, taken from its date cells rather
  // than from its title. The 08/01-08/15 file is titled for the whole
  // fortnight and its last day is the 14th.
  periodFrom String
  periodTo   String

  // the uploaded spreadsheet, kept for audit and streamed back through a gated
  // route like every other stored document here.
  sourceUrl  String?
  sourceName String?

  // the QSP pair, since the pipeline went QSP-first on 2026-08-17: the Simple
  // Timesheet PDF that hours and punches come from, and the Rest Periods
  // Report the rest evidence comes from. David's spreadsheet (sourceUrl above)
  // stays as the record of the 2nd breaks typed into DSN summaries.
  timesheetUrl  String?
  timesheetName String?
  restsUrl      String?
  restsName     String?
  // every row of the rest report, from rests.allRestRows() - same shape and
  // same reasoning as TimesheetBatch.restsByDate.
  restsByDate   Json?

  // everything the reader could not make sense of, whole: the breaks marked not
  // documented, the lengths that are not ten minutes, the times that land at
  // half past ten at night, the note somebody typed one column too far right.
  // Stored on the batch because it is a fact about the FILE, and because the
  // review screen is the point of this feature - nothing generates until a
  // person has been through it.
  faults Json?

  // whether sends from this batch were redirected to the test inbox - recorded
  // per batch so a test run can never be mistaken for a real one later, same
  // as TimesheetBatch.testMode.
  testMode Boolean @default(true)

  // SOMEBODY HAS SAID THIS EXPORT IS FINAL. Same attestation as the MLS batch,
  // and here it is the WHOLE send gate: the day program's last workday is
  // usually short of the printed period end (nobody works the Saturday the
  // 15th), so the reach-the-end derivation the MLS card uses would hold Send
  // all hostage forever. A person says it is final, and that is recorded.
  lockedAt     DateTime?
  lockedById   String?
  lockedByName String?

  uploadedById String
  uploadedBy   User              @relation("DayProgramBatchUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sheets       DayProgramSheet[]

  @@index([createdAt])
}

// one person's day program sheet for a period.
model DayProgramSheet {
  id      String          @id @default(cuid())
  batchId String
  batch   DayProgramBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // the name exactly as the spreadsheet spells it, kept even after matching so
  // the operator can always see what the source said.
  sourceName  String
  userId      String?
  user        User?   @relation("DayProgramEmployee", fields: [userId], references: [id], onDelete: SetNull)
  matchMethod String  @default("unmatched")

  // the period total, duplicated out of `days` for lists and sorting the same
  // way the timesheet figures are.
  totalHours Float @default(0)
  // how many days in here carry something a person should look at
  faultCount Int   @default(0)

  // every day for this person as the reader read it: the date, the shift
  // length, the two break cells with whatever times survived parsing, the
  // sources, and the correction note.
  //
  // NO PUNCHES, because the report has none. Every "Actual Work Shift" cell in
  // the file reads "6.5 hrs (exact start/end not shown)", so there is no clock
  // record here to store and the sheet cannot print one.
  days Json

  // delivery and signing, the same shape the timesheets use. Day program staff
  // take no unpaid meal period, so nothing here records one.
  sentAt        DateTime?
  sentToEmail   String?
  intendedEmail String?
  dueAt         DateTime?
  message       String?
  signedAt      DateTime?
  signedPdfUrl  String?
  signedName    String?
  signedIp      String?

  // set when the employee reports something wrong; a disputed sheet can't be
  // signed until management clears it, same rule as the timesheets.
  disputedAt DateTime?

  // management sign-off after the employee has signed - the approved copy is
  // the final record, stamped at the approval line server-side.
  approvedAt     DateTime?
  approvedById   String?
  approvedPdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([userId])
}

// PAID TIME OFF, AS ITS OWN RECORD RATHER THAN AS HOURS ON A SHEET.
//
// KEYED LIKE THE BREAK ANSWERS, and for the same reason: (program, period,
// person, date) rather than a timesheet id. PTO is agreed with a person before
// any export is pulled and must not be re-entered every time a period is
// re-uploaded - a batch-scoped record would be wiped by the next upload, which
// is exactly how nine people's time off would quietly vanish.
//
// IT DOES NOT NEED A TIMESHEET TO EXIST. Somebody whose whole fortnight is PTO
// never appears on a QSP export, because they worked no hours and QSP prints
// punches. Hanging this off a sheet would make their time off unrecordable.
//
// HOURS HERE ARE NOT WORKED HOURS. They are shown beside the worked figures and
// counted in neither the paid total nor the over-40 overtime test - a PTO day
// is not a shift, owes no rest breaks, and must never push somebody into
// overtime on time they did not work.
model PtoEntry {
  id         String  @id @default(cuid())
  program    String  @default("MLS")
  periodFrom String
  periodTo   String
  // the account, the same key TimesheetBreakAnswer uses. Not the export's
  // spelling of the name, which differs between documents for the same person.
  personKey  String
  // the day it covers, in the sheet's own format ("08/10/26"), so it lines up
  // with `day.date` without parsing on either side.
  date       String
  hours      Float
  note       String?

  // who recorded it, as scalars - this is a record of an agreement and must not
  // follow a rename or cascade away with an account.
  byId   String?
  byName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([program, periodFrom, periodTo, personKey, date])
  @@index([program, periodFrom, periodTo])
}

// ONE MONTH'S CLIENT ATTESTATION RUN.
//
// The job, in HR's own words: "Pull current client schedule ... work with
// supervisors to have clients review and sign an attestation confirming they
// were provided their schedule, they want to continue with their current staff,
// and staff have been providing services as scheduled."
//
// It happens once a month, so the whole thing hangs off one upload: QSP's
// Client Schedules export, one page per client. August 2026 was 252 pages and
// 252 clients. Each page becomes one form somebody signs.
//
// SHAPED LIKE TimesheetBatch DELIBERATELY - upload a QSP export, cut it into one
// document per person, match those to accounts, send them out, collect
// signatures - because it is the same job with different nouns, and the second
// copy of a workflow should not invent a second set of habits.
model ClientAttestationBatch {
  id String @id @default(cuid())

  // the month every page of the export prints in its header, e.g. "August 2026".
  // Taken from the document rather than picked by the operator: a batch labelled
  // one month and holding another is not a mistake anybody catches later.
  monthLabel String

  // the uploaded source PDF, kept for audit and streamed back through a gated
  // route like every other stored document here.
  sourceUrl  String?
  sourceName String?

  // whether sends from this batch were redirected to the test inbox. Recorded
  // per batch, and defaulting to TRUE, for the same reason the timesheet batches
  // do it: a test run must never be mistakable for a real one afterwards.
  testMode Boolean @default(true)

  uploadedById String
  uploadedBy   User   @relation("ClientAttestationBatchUploadedBy", fields: [uploadedById], references: [id])

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  attestations ClientAttestation[]

  @@index([createdAt])
}

// ONE CLIENT'S SCHEDULE PAGE AND THE SIGN-OFF IT COLLECTS.
model ClientAttestation {
  id      String                 @id @default(cuid())
  batchId String
  batch   ClientAttestationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // the name exactly as the schedule printed it ("Jacob Acuna"), kept even after
  // matching so the operator can always see what the source said.
  clientName String
  // the same name reduced to sorted tokens, which is what joins this page to
  // HR's roster - that document spells it the other way round ("Acuna, Jacob").
  // See src/lib/client-attestations/names.js.
  clientKey  String
  // which page of the source PDF this came off, 1-based, so a form can always be
  // traced back to the document it was cut from.
  sourcePage Int

  // WHO IS ON THIS SCHEDULE, exactly as QSP abbreviated them ("Solorzano, I").
  // This is what the client is being asked about - whether they want to continue
  // with these people - and it is also how the form finds its supervisor.
  staffNames     String[] @default([])
  // what the page adds up to, for the review screen. Not a payroll figure and
  // never used as one: it is the scheduled total, not hours worked.
  scheduledHours Float    @default(0)
  entryCount     Int      @default(0)

  // FROM HR'S ROSTER, copied at upload rather than joined live. The roster is a
  // spreadsheet somebody re-exports every month; a form that changed its mind
  // about who the case worker was after it had been signed would be worthless.
  caseWorker  String?
  clientEmail String?
  office      String?

  // ROUTING. Both nullable and both only ever suggestions until somebody
  // confirms them - a wrong match sends one client's schedule to another
  // client's supervisor.
  staffUserId      String?
  staffUser        User?   @relation("ClientAttestationStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  supervisorUserId String?
  supervisor       User?   @relation("ClientAttestationSupervisor", fields: [supervisorUserId], references: [id], onDelete: SetNull)
  // how the staff match happened: initial | manual | ambiguous | unmatched
  matchMethod      String  @default("unmatched")

  // the generated form - the client's schedule page with the sign-off block
  // under it. Stored rather than rebuilt on demand because this is the document
  // that gets signed, and a form that re-renders differently after the fact is
  // not the thing anybody agreed to.
  formUrl String?

  // delivery
  sentAt        DateTime?
  // the address it actually went to - in test mode that is the tester, which is
  // why the address it was MEANT for is stored beside it.
  sentToEmail   String?
  intendedEmail String?
  dueAt         DateTime?

  // signing
  signedAt     DateTime?
  signedPdfUrl String?
  signedName   String?
  signedIp     String?
  // which kind of recipient the send went to: supervisor | staff | client |
  // other. The address alone doesn't say - a supervisor and a typed address
  // look identical a month later.
  sentToKind   String?

  // THE CLIENT'S HALF OF THE SIGNATURE, when it happens first.
  //
  // Mánu 2026-08-24: a link sent to the client (or to the staff sitting with
  // them) offers ONLY the client's fields; the supervisor link carries the
  // whole form. When the client half is filed first, the partly-filled PDF
  // lands here and goes on to the field supervisor for the rest - the final
  // copy still arrives in signedPdfUrl like every other one.
  clientSignedAt     DateTime?
  clientSignedPdfUrl String?
  clientSignedIp     String?
  // which link filed it: "client" or "staff"
  clientSignedVia    String?
  // "portal" when it came back through the emailed link, "paper" when somebody
  // sat with the client, signed it on paper and uploaded the scan. Both are real
  // and the second one is how most of these will actually happen this month.
  signedVia    String?
  // who filed the paper copy, as scalars: a record of who did it AT THE TIME,
  // which must not follow a later rename or cascade away with a closed account.
  filedById    String?
  filedByName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([clientKey])
  @@index([supervisorUserId])
  @@index([signedAt])
}


// THE CLIENT ROSTER: WHICH STAFF HAVE WHICH CLIENTS.
//
// Mánu 2026-08-24: "there should be database showing that. which staff have
// which clients. because this would be the hierarchy - Field Supervisor >
// Staff > Clients."
//
// One row per client, imported from HR's roster spreadsheet. The staff half of
// the hierarchy is this table; the supervisor half is User.supervisorId, so the
// full tree is Client -> assigned staff -> that staff's field supervisor and
// nothing here stores the supervisor twice.
//
// NO EMAIL COLUMN, DELIBERATELY. The spreadsheet carries client emails; Mánu
// 2026-08-24: "for now we dont store clients emails." A send to a client is a
// typed address every time until that decision changes.
model Client {
  id String @id @default(cuid())

  // the name as HR's roster prints it, e.g. "Acuna, Jacob"
  name      String
  // the same name as sorted tokens - the key that joins this row to a schedule
  // page, which spells the same person "Jacob Acuna". See
  // src/lib/client-attestations/names.js.
  clientKey String @unique
  office    String?
  status    String?

  // the assigned staff, exactly as the roster printed them ("Gutierrez, Joseph"),
  // kept even after matching so the screen can always show what the source said
  caseWorkerName String?
  // the same person as a portal account, when exactly one matches
  staffUserId String?
  staffUser   User?   @relation("ClientAssignedStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffUserId])
}

// A REPORT FILLED OUT ABOUT ONE CLIENT, 2026-08-31.
//
// Mánu: "we will eventually have multiple reports that we will be filling out
// per client and we will eventually be able to generate reports per client
// across all the reports we make through the portal." So one table for all of
// them, discriminated by `kind` - the first kind is "annual-satisfaction", the
// Annual Client / Parent Satisfaction Survey conducted over the phone or in
// person and rendered to PDF on demand from the stored answers.
//
// KEYED BY clientKey, NOT Client.id, for the same reason ShiftReview is keyed
// to the shift: the roster import replaces the Client table wholesale, and a
// filled survey must outlive every re-import. The name is copied in as it
// stood so the record still reads right even if the roster later spells the
// person differently.
model ClientReport {
  id String @id @default(cuid())

  // which report this is - "annual-satisfaction" for now, more kinds to come
  kind String

  // the client, as sorted name tokens (src/lib/client-attestations/names.js)
  // plus the roster spelling at the moment of filling
  clientKey  String
  clientName String

  // the answers, shaped by the report's own definition module under
  // src/lib/client-reports/. The PDF is rendered from this on demand - the
  // answers are the record, the document is a view of them.
  answers Json

  // who conducted it - the signed-in person asking the questions. Name copied
  // as scalars so the record keeps saying who it was at the time.
  conductedById   String
  conductedBy     User   @relation("ClientReportConductedBy", fields: [conductedById], references: [id])
  conductedByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientKey])
  @@index([kind, createdAt])
}

// A CLIENT'S AUTHORIZED HOURS FOR ONE MONTH, 2026-08-31.
//
// From QSP's Budget Capture Report - one row per client per service type,
// carrying the monthly authorization ("the amount of hours the clients are
// given a month", Mánu). The audit's client report reads billable hours
// against this. Keyed by clientKey like every client-anchored record here,
// so roster re-imports can't orphan it; a month is replaced wholesale by
// re-uploading its report.
model ClientAuthorization {
  id String @id @default(cuid())

  // "2026-08" - read off the report's own title line, never typed
  monthKey String

  clientKey  String
  clientName String
  office     String?
  // as the report prints it ("Gutierrez, Joseph")
  caseManagerName String?
  // "ILS POS (520 Monthly)" - kept apart so a client with two authorizations
  // holds two rows; empty string rather than null so the unique key works
  serviceType String @default("")

  authorizedHours Float
  // QSP's own scheduled-hours figure at export time, kept for reference
  scheduledHours Float?

  sourceName String?

  uploadedById String
  uploadedBy   User   @relation("ClientAuthorizationUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([monthKey, clientKey, serviceType])
  @@index([monthKey])
  @@index([clientKey])
}

// THE SERVICE NOTES AUDIT, 2026-08-26.
//
// Mánu: "i need to go through the service notes and see whether or not the time
// that is billed adds up for what the service is on paper."
//
// The Employee Detailed Daily Service Notes export is one note per shift,
// written by the person who worked it, and it carries its own shift times -
// which are the CLOCK times, matching the QSClock export exactly on 330 of 373
// notes in the week both cover. So a period holds three records of one shift:
// what the roster billed, what the clock recorded, and what the note documents.
// The audit is the reconciliation of those three.
//
// SEPARATE FROM TimesheetBatch ON PURPOSE. The notes are exported over a date
// range the operator picks, not over a pay period, and this one covers 8/1 to
// 8/26 across two of them. Hanging it off a batch would force a range that is
// not the document's own into the record.
model ServiceNoteBatch {
  id String @id @default(cuid())

  // the range the notes actually cover, read off the notes rather than typed:
  // a batch labelled one range and holding another is not a mistake anybody
  // catches later. Same spelling as everywhere else here, "08/01/26".
  periodFrom String
  periodTo   String

  // the uploaded source PDF, kept for audit and streamed back through a gated
  // route like every other stored document here.
  sourceUrl  String?
  sourceName String?

  // THE PARSED NOTES, and unlike the clock rows on TimesheetBatch these ARE
  // stored. Re-reading costs 2.6 seconds against the clock export's 8ms, which
  // is too slow to spend on a page view. 1.43MB for a month.
  //
  // It is safe here in a way it was not there: nothing else in the app loads a
  // ServiceNoteBatch, so no unrelated query drags this along. THE LIST PAGE
  // MUST STILL `select` WITHOUT IT - a list of twelve months would otherwise
  // pull seventeen megabytes to print twelve dates.
  notes Json

  noteCount Int @default(0)

  uploadedById String
  uploadedBy   User   @relation("ServiceNoteBatchUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// A REVIEWER'S DECISION ABOUT ONE BILLED SHIFT, 2026-08-26.
//
// Mánu: "then we can pick flag for review or approved then logs when and who
// approved what". Approve means the shift looks right to bill.
//
// KEYED TO THE SHIFT, NOT TO THE UPLOAD IT WAS READ FROM. Pay periods are
// re-uploaded constantly - four batches for 08/16-08/31 alone - and every
// re-upload writes new Timesheet rows. A decision hanging off one of those rows
// is discarded the moment somebody corrects a period, which is precisely when
// the reviewing has already been done. `shiftKey` is built from what the
// DOCUMENTS say (the person, the day, the rostered start, the client), so it
// survives a re-upload, a re-parse and a rebuild.
//
// THE FIGURES ARE COPIED IN AS THEY STOOD. What was approved is the reading in
// front of the reviewer at the time - if a later upload changes the hours, this
// row still says what was actually signed off, which is the whole point of
// having a record rather than a flag.
model ShiftReview {
  id String @id @default(cuid())

  // person|date|startMin|client - see `shiftKeyOf` in note-audit.js
  shiftKey String @unique

  // the parts, kept separately as well so the table can be read and grouped
  // without taking the key apart again
  employeeKey String
  date        String
  startMin    Int?
  client      String?
  service     String?

  // "approved" - it looks right to bill - or "flagged", which owes a reason
  decision String
  reason   String?

  // the reading at the moment of the decision
  billedMin     Int?
  clockedMin    Int?
  documentedMin Int?

  // WHAT THE REVIEWER SAYS IS ACTUALLY BILLABLE, 2026-08-31. Mánu: "when i go
  // through every shift i can adjust how much of the time is actually
  // billable." Null means the billed figure stands; a value is the corrected
  // billable minutes, and the client report sums billableMin ?? billedMin.
  billableMin Int?

  decidedById String
  decidedBy   User   @relation("ShiftReviewDecidedBy", fields: [decidedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([decision])
  @@index([employeeKey])
  @@index([date])
}
